# Copy to infra/.env.stack (gitignored) for docker-compose.stack.yml.

# Long random string (min 32 chars). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
POSTGRES_PASSWORD=erp
# Password of the demo owner created by the seed (demo@grossiste.dz).
SEED_OWNER_PASSWORD=Demo1234!

# Host ports. Changing API_PORT needs a rebuild of the web image (--build).
WEB_PORT=3010
API_PORT=3011
DB_PORT=5434
