# One per environment on the server: /srv/erp/staging.env and /srv/erp/production.env
# (chmod 600, never in git). docs/runbook.md, "First server setup", says how to fill it.
# Passwords go into URLs: generate them with `openssl rand -hex 24` (no special chars).

# staging | production
APP_ENV=staging
IMAGE_PREFIX=ghcr.io/islam-debbi-dev/erp-saas
# APP_TAG (the git sha) and STACK_NAME (erp-<env>) are set by deploy.sh.

# --- Database
# owner (migrations, backups)
POSTGRES_PASSWORD=
# erp_app, the role the API runs as (RLS)
APP_DB_PASSWORD=

# --- API
# openssl rand -base64 48
JWT_ACCESS_SECRET=
WEB_ORIGIN=https://staging.example.com
LOG_LEVEL=info
# empty = Sentry off (project erp-api)
SENTRY_DSN=
# Sentry project erp-web, for server-side rendering errors (the browser one is baked
# into the image from the WEB_SENTRY_DSN repository variable).
WEB_SENTRY_DSN=
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=30

# --- Backups (WAL-G → S3-compatible bucket, e.g. Backblaze B2 or Cloudflare R2)
# Each environment gets its own prefix; staging and production never share one.
WALG_S3_PREFIX=s3://erp-backups/staging
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-003
AWS_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
AWS_S3_FORCE_PATH_STYLE=true
# Client-side encryption of every backup and WAL segment: openssl rand -hex 32.
# Keep a copy OFF the server (password manager): without it, backups can't be read.
WALG_LIBSODIUM_KEY=
WALG_LIBSODIUM_KEY_TRANSFORM=hex
WALG_COMPRESSION_METHOD=brotli
# Algiers time
BACKUP_AT=02:00
# daily full backups kept (30 days of PITR)
BACKUP_RETAIN_FULL=30
# Called when a backup fails (Better Stack / Slack / ntfy incoming webhook).
ALERT_WEBHOOK_URL=

# --- Logs (optional): Better Stack Logs source token.
LOGTAIL_TOKEN=
LOGTAIL_HOST=in.logs.betterstack.com
