{
  "name": "erp-saas",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @erp/api db:migrate",
    "db:seed": "pnpm --filter @erp/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
