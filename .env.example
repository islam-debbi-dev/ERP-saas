
# Assistant IA (phase 30)
# Encrypts provider API keys at rest: openssl rand -base64 32. Unset: no key can be saved.
SECRETS_ENCRYPTION_KEY=
AI_MAX_OUTPUT_TOKENS=1500
# Local dev and the eval script only, used when no PLATFORM config row exists.
# AI_PROVIDER is ANTHROPIC, GEMINI or OPENAI_COMPATIBLE (AI_BASE_URL needed for the last one).
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# saas, or single for one company on its own server (phase 29).
DEPLOYMENT_MODE=saas
