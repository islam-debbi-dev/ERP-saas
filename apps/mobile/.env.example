# Debvora env template.
# Copy to assets/config/env.default (gitignored; the file the app loads) and fill
# in, or override any key at build time with --dart-define=KEY=value.
# Priority: --dart-define > assets/config/env.default > the fallback in
# lib/core/config/app_env.dart. Never put a secret here: the file ships inside
# the app.

# In-app name (wordmark, task switcher). The launcher label is native: see
# package_rename_config.yaml and docs/branding.md.
APP_NAME=Debvora

# Brand colours, "#RRGGBB" in quotes (unquoted, the # starts a comment).
# Every colour in the app derives from these two and the neutral tokens of
# lib/core/theme/app_theme.dart.
#   PRIMARY   = brand accent (its deep and tint shades are derived).
#   SECONDARY = action colour (buttons, active tab), shown with contrasting text.
APP_PRIMARY_COLOR="#FFD83A"
APP_SECONDARY_COLOR="#1E1E1E"

# The ERP API, no trailing slash and no /api prefix (the API has none).
#   Production        https://erp-saas-pi.vercel.app   (the fallback when empty)
#   Android emulator  http://10.0.2.2:3001
#   iOS simulator     http://localhost:3001
#   Real phone        http://<your Mac's LAN IP>:3001  (same Wi-Fi)
# See docs/local-development.md.
API_BASE_URL=https://erp-saas-pi.vercel.app

# The web dashboard. Owners and managers are refused in the app and shown this
# link. Leave empty to hide the link. Local: http://10.0.2.2:3000
DASHBOARD_URL=

# Contact addresses shown in the help and privacy screens (hidden when empty).
SUPPORT_EMAIL=
PRIVACY_EMAIL=
