# ─────────────────────────────────────────────────────────────────────────────
# Jibli white-label env template
# ─────────────────────────────────────────────────────────────────────────────
# 1) Copy this file to `assets/config/env.default` (the file the app actually
#    loads via flutter_dotenv) and fill in values, OR override any key at build
#    time with:  flutter run --dart-define=KEY=value
# 2) Priority is: `--dart-define` > `assets/config/env.default` > hardcoded
#    fallback (for API_BASE_URL that is `core/service/api_constants.dart`).
# 3) Do not commit real secrets. `assets/config/env.default` / `/.env` are
#    gitignored — keep this template with empty values.
# 4) This is the ONLY file a buyer needs to edit to get a branded build for the
#    runtime settings below. Any native/per-client step is documented in
#    `docs/white-label-client-onboarding.md` (it cannot be done via .env).
# ─────────────────────────────────────────────────────────────────────────────

# In-app app name (MaterialApp `title` / task-switcher label).
# NOTE: the home-screen launcher label + icon are a separate NATIVE step done
# once per client (flutter_launcher_icons / package_rename) — see the doc.
APP_NAME=Jibli

# Brand colors, two `#RRGGBB` values.
#  PRIMARY   = brand accent (Jibli yellow).
#  SECONDARY = action colour for buttons / active states (Jibli ink black,
#              always shown with white text).
# Neutrals (white surfaces, greys) are fixed design tokens in AppColors.
APP_PRIMARY_COLOR=#FFD83A
APP_SECONDARY_COLOR=#1E1E1E

# Logo drawn on the auth screen. Either replace `assets/main-logo.png` with the
# client's own file, or point this key at a different bundled asset.
APP_LOGO_ASSET=assets/main-logo.png

# Contact addresses rendered in Help Center and Privacy Policy. Set them to the
# client's real inbox; leaving the placeholder is a shipping mistake.
SUPPORT_EMAIL=support@jibli.org
PRIVACY_EMAIL=jiblimsila@gmail.com

# Backend API base URL, including `/api/v1`. Images come back on the same
# host the app calls, so this one value decides whether they load.
#   iOS simulator     http://localhost:5001/api/v1
#   Android emulator  http://10.0.2.2:5001/api/v1   (localhost = the emulator)
#   Real phone        http://<your Mac's LAN IP>:5001/api/v1   (same Wi-Fi)
#   Production        https://api.your-company.com/api/v1
# See docs/local-development.md.
API_BASE_URL=https://api.104.207.90.5.sslip.io/api/v1

# Web dashboard opened by a store manager's "Manage my store" tile. Leave empty
# to derive it from API_BASE_URL (`api.<domain>` → `https://admin.<domain>`).
DASHBOARD_URL=

# ── Optional social-auth provider keys ──────────────────────────────────────
# A provider's button is rendered ONLY when its key below is non-empty.
# Leaving both empty shows no social buttons on the auth screen.
# Each key needs companion NATIVE setup before the button will actually work
# (see docs/white-label-client-onboarding.md, section per provider).

# GOOGLE_WEB_CLIENT_ID: Google OAuth Web / Server client ID (the "Web
# application" client id, NOT the Android one). Used at runtime by
# google_sign_in to request an ID token that is sent to YOUR backend for
# verification. Get it from: Google Cloud Console → API & Services →
# Credentials → OAuth 2.0 Client IDs.
# Still required natively regardless of this value: replace
# `android/app/google-services.json` and `ios/Runner/GoogleService-Info.plist`
# with ones generated for the client's own package name + SHA-1.
GOOGLE_WEB_CLIENT_ID=


# APPLE_SERVICE_ID: your Services ID (a reverse-domain string, e.g.
# com.yourco.app.signin) from developer.apple.com. Used by sign_in_with_apple
# at runtime. Still requires the "Sign in with Apple" capability enabled in
# Xcode for the client's bundle id per the doc. Never shown on Android.
APPLE_SERVICE_ID=
