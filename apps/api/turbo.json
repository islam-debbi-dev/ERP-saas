{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // The Prisma client is generated into src/ (git-ignored); a cache hit must restore it,
      // or a host that compiles src/ itself (Vercel) builds without it.
      "outputs": ["dist/**", "src/generated/**"]
    }
  }
}
