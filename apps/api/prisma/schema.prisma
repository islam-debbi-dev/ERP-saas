// Phase 1 schema: tenancy, users, sessions, audit, numbering, idempotency.
// Rules (AGENTS.md §3): every business table has tenantId (indexes start with it),
// money is Decimal(14,2), no hard deletes on business data, audit log is append-only.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  SELLER
  STOREKEEPER
  SUPERVISOR
  LIVREUR
}

/// Which clients a seller sees when SALES_FORCE is on (phase 14).
enum SellerScope {
  ALL_CLIENTS
  ASSIGNED_ONLY
}

enum CreditLimitMode {
  WARN
  BLOCK
}

enum NegativeStockMode {
  ALLOW
  WARN
  BLOCK
}

enum DocType {
  BL
  FAC
  AV
  BR
  VER
  INV
  RF
  /// Règlement fournisseur (phase 21).
  RGF
  /// Transfert de stock: chargement / déchargement (phase 15).
  TR
  /// Bon de commande: pre-sale order (phase 16).
  BC
  /// Dossier d'importation (phase 22).
  DI
  /// Dépense (phase 25).
  DEP
  /// Matricule of an employee (phase 31): per tenant, stored under year 0.
  EMP
  /// Paie: one approved payroll run (phase 31b).
  PAIE
  /// Transfert de trésorerie (phase 34).
  TRF
}

enum PrintFormat {
  A4
  A5
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

/// A grossiste (our customer). Holds the tenant settings from docs/domain.md.
model Tenant {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)

  // Invoice header
  raisonSociale String  @db.VarChar(160)
  adresse       String? @db.VarChar(255)
  telephone     String? @db.VarChar(40)
  rc            String? @db.VarChar(40)
  nif           String? @db.VarChar(40)
  nis           String? @db.VarChar(40)
  ai            String? @db.VarChar(40)
  rib           String? @db.VarChar(60)

  // Business rules
  assujettiTva      Boolean           @default(true)
  creditLimitMode   CreditLimitMode   @default(WARN)
  negativeStockMode NegativeStockMode @default(WARN)
  priceLevelCount   Int               @default(3) @db.SmallInt
  /// Line discount any seller may give; above it needs DISCOUNT_ABOVE_X (phase 11).
  maxDiscountPct    Decimal           @default(0) @db.Decimal(5, 2)

  // Timbre fiscal rule (cash-paid factures). Off until the tenant sets current law values.
  timbreEnabled           Boolean  @default(false)
  /// Deprecated (phase 8): replaced by timbreTranches, no longer read. Drop in a later release.
  timbreRate              Decimal? @db.Decimal(7, 4)
  timbreMin               Decimal? @db.Decimal(14, 2)
  timbreMax               Decimal? @db.Decimal(14, 2)
  timbreThreshold         Decimal? @db.Decimal(14, 2)
  /// A comptage with an écart from this amount up alerts the owner (phase 34).
  cashCountAlertThreshold Decimal  @default(5000) @db.Decimal(14, 2)
  /// Objectif de ventes du mois, TTC (phase 33); null = none. Set by the OWNER.
  monthlySalesTarget      Decimal? @db.Decimal(14, 2)
  /// [{ upTo: "30000.00" | null, rate: "1" }] in increasing order, see packages/shared/timbre.
  timbreTranches          Json     @default("[]")

  // Printed documents
  defaultPrintFormat PrintFormat @default(A4)
  documentFooter     String?     @db.VarChar(500)
  tvaMention         String      @default("Non assujetti à la TVA") @db.VarChar(120)

  /// "Clients à relancer": oldest unpaid document older than this many days (phase 21).
  reminderDays Int @default(30) @db.SmallInt

  /// May this company use its own AI provider key in SaaS mode? Set by the super-admin (phase 30).
  allowTenantAiKey Boolean @default(false)

  sellerScope SellerScope @default(ALL_CLIENTS)

  /// Géolocalisation (phase 17, GEO_CHECK): far operations are flagged (default) or blocked.
  geoCheckMode    GeoCheckMode @default(FLAG)
  geoRadiusM      Int          @default(150) @db.SmallInt
  geoMaxAccuracyM Int          @default(200) @db.SmallInt

  // DRH calendar (phase 31). Weekly rest days: 0 = Sunday, default Friday.
  hrRestDays         Int[]   @default([5])
  hrDailyHours       Int     @default(8) @db.SmallInt
  hrLeaveAccrualDays Decimal @default(2.5) @db.Decimal(3, 1)
  hrSelfCheckIn      Boolean @default(false)

  // Paie (phase 31b).
  payrollDayDivisor     Int     @default(30) @db.SmallInt
  payrollHourDivisor    Decimal @default(173.33) @db.Decimal(6, 2)
  payrollOvertimeRate   Decimal @default(0.50) @db.Decimal(4, 2)
  payrollDeductLateness Boolean @default(false)

  /// The owner hid the dashboard onboarding checklist (phase 13).
  onboardingDismissedAt DateTime? @db.Timestamptz(3)

  /// Modules the super-admin added to / took from the edition (phase 13b, packages/shared/features).
  featureGrants  String[] @default([])
  featureRevokes String[] @default([])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users                    User[]
  sessions                 Session[]
  auditLogs                AuditLog[]
  userInvitations          UserInvitation[]
  documentSequences        DocumentSequence[]
  idempotencyKeys          IdempotencyKey[]
  categories               Category[]
  units                    Unit[]
  priceLevels              PriceLevel[]
  products                 Product[]
  productUnits             ProductUnit[]
  productPrices            ProductPrice[]
  productStocks            ProductStock[]
  stockMovements           StockMovement[]
  inventories              Inventory[]
  inventoryLines           InventoryLine[]
  suppliers                Supplier[]
  purchases                Purchase[]
  purchaseLines            PurchaseLine[]
  purchaseReturns          PurchaseReturn[]
  purchaseReturnLines      PurchaseReturnLine[]
  clients                  Client[]
  clientLedger             ClientLedgerEntry[]
  clientBalances           ClientBalance[]
  sales                    Sale[]
  saleLines                SaleLine[]
  saleReturns              SaleReturn[]
  saleReturnLines          SaleReturnLine[]
  payments                 Payment[]
  paymentAllocations       PaymentAllocation[]
  documentPrints           DocumentPrint[]
  importJobs               ImportJob[]
  subscription             Subscription?
  subscriptionPayments     SubscriptionPayment[]
  supplierLedger           SupplierLedgerEntry[]
  supplierBalances         SupplierBalance[]
  supplierPayments         SupplierPayment[]
  shareLinks               ShareLink[]
  brands                   Brand[]
  sectors                  Sector[]
  warehouses               Warehouse[]
  warehouseStocks          WarehouseStock[]
  stockTransfers           StockTransfer[]
  stockTransferLines       StockTransferLine[]
  routes                   Route[]
  routeStops               RouteStop[]
  visits                   Visit[]
  orders                   Order[]
  orderLines               OrderLine[]
  sellerSessions           SellerSession[]
  geoChecks                GeoCheck[]
  geoCheckReviews          GeoCheckReview[]
  clientGeoRequests        ClientGeoChangeRequest[]
  salesTargets             SalesTarget[]
  incentivePlans           IncentivePlan[]
  incentiveRules           IncentiveRule[]
  incentiveRuns            IncentiveRun[]
  incentiveLines           IncentiveLine[]
  importFiles              ImportFile[]
  importCosts              ImportCost[]
  importAllocations        ImportCostAllocation[]
  promotions               Promotion[]
  promotionProducts        PromotionProduct[]
  promotionClients         PromotionClient[]
  packagingTypes           PackagingType[]
  productPackagings        ProductPackaging[]
  clientPackaging          ClientPackagingEntry[]
  clientPackagingBals      ClientPackagingBalance[]
  userWarehouseAccesses    UserWarehouseAccess[]
  warehouseBrands          WarehouseBrand[]
  warehouseCategories      WarehouseCategory[]
  expenseCategories        ExpenseCategory[]
  expenses                 Expense[]
  cashAccounts             CashAccount[]
  cashAccountBalances      CashAccountBalance[]
  cashMovements            CashMovement[]
  cashTransfers            CashTransfer[]
  cashCounts               CashCount[]
  rentContracts            RentContract[]
  employees                Employee[]
  employeeSalaries         EmployeeSalary[]
  employeeBalances         EmployeeBalance[]
  employeeLedgerEntries    EmployeeLedgerEntry[]
  attendanceEvents         AttendanceEvent[]
  attendanceDays           AttendanceDay[]
  attendanceMonthLocks     AttendanceMonthLock[]
  publicHolidays           PublicHoliday[]
  payItemTypes             PayItemType[]
  employeePayItems         EmployeePayItem[]
  payrollRuns              PayrollRun[]
  aiProviderConfigs        AiProviderConfig[]
  assistantConversations   AssistantConversation[]
  assistantMessages        AssistantMessage[]
  payrollRateSets          PayrollRateSet[]
  payrollRateConfirmations PayrollRateConfirmation[]
  payslips                 Payslip[]
  payslipLines             PayslipLine[]
  payrollManualLines       PayrollManualLine[]
  leaveRequests            LeaveRequest[]
  leaveEntries             LeaveEntry[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  /// Globally unique (lowercased) so login needs no company code. A user has an
  /// email, a phone, or both (CHECK in the migration).
  email              String?   @unique @db.VarChar(254)
  /// `+213…` (normalizePhone), globally unique like the email.
  phone              String?   @unique @db.VarChar(20)
  passwordHash       String    @db.VarChar(255)
  fullName           String    @db.VarChar(120)
  role               Role
  /// Exceptions to the role's default permissions (packages/shared/permissions.ts).
  permissionGrants   String[]  @default([])
  permissionRevokes  String[]  @default([])
  /// Temporary password set by the owner: every route but the password change refuses.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime? @db.Timestamptz(3)
  /// Consecutive wrong passwords; 5 lock the account for 15 minutes.
  failedLoginCount   Int       @default(0) @db.SmallInt
  lockedUntil        DateTime? @db.Timestamptz(3)
  createdBy          String?   @db.Uuid
  /// The supervisor or manager this user reports to (phase 14). Never a cycle.
  managerId          String?   @db.Uuid
  /// Phase 33.5: his dashboard cards, order and hidden ones; null = his role's default.
  dashboardLayout    Json?
  /// Deactivated: sessions revoked, cannot log in. Never deleted (history keeps the name).
  deletedAt          DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  sessions               Session[]
  invitations            UserInvitation[]
  manager                User?                   @relation("UserManager", fields: [managerId], references: [id], onDelete: Restrict)
  members                User[]                  @relation("UserManager")
  clients                Client[]                @relation("ClientSeller")
  sales                  Sale[]                  @relation("SaleSeller")
  collected              Payment[]               @relation("PaymentCollector")
  vehicles               Warehouse[]             @relation("WarehouseDriver")
  routes                 Route[]                 @relation("RouteSeller")
  visits                 Visit[]                 @relation("VisitSeller")
  orders                 Order[]                 @relation("OrderSeller")
  deliveries             Order[]                 @relation("OrderLivreur")
  sellerDays             SellerSession[]         @relation("SessionSeller")
  managedWarehouses      Warehouse[]             @relation("WarehouseManager")
  warehouseAccess        UserWarehouseAccess[]   @relation("AccessUser")
  assistantConversations AssistantConversation[]
  employee               Employee?

  @@index([tenantId, role])
  @@index([tenantId, managerId])
  @@map("users")
}

/// One-time link to set a password (72 h). Only sha256(token) is stored.
model UserInvitation {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdBy String?   @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
  @@map("user_invitations")
}

/// One logged-in device. The refresh token is `<sessionId>.<secret>`; only sha256(secret) is stored.
model Session {
  id                       String    @id @default(uuid()) @db.Uuid
  tenantId                 String    @db.Uuid
  userId                   String    @db.Uuid
  refreshTokenHash         String    @db.Char(64)
  /// The token replaced by the last rotation, accepted once more during a short grace
  /// window (a reload that lost the response must not log the user out).
  previousRefreshTokenHash String?   @db.Char(64)
  rotatedAt                DateTime? @db.Timestamptz(3)
  deviceName               String?   @db.VarChar(100)
  userAgent                String?   @db.VarChar(255)
  ip                       String?   @db.VarChar(45)
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt               DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt                DateTime  @db.Timestamptz(3)
  revokedAt                DateTime? @db.Timestamptz(3)
  /// LOGOUT | REVOKED | REUSE_DETECTED
  revokedReason            String?   @db.VarChar(30)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, revokedAt])
  @@map("sessions")
}

/// Append-only: never updated or deleted (enforced by the tenant Prisma extension).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  sessionId  String?  @db.Uuid
  deviceName String?  @db.VarChar(100)
  ip         String?  @db.VarChar(45)
  action     String   @db.VarChar(60)
  entity     String   @db.VarChar(60)
  entityId   String?  @db.VarChar(64)
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, userId, createdAt])
  @@map("audit_logs")
}

/// Last number used per tenant, document type and year. Incremented under SELECT ... FOR UPDATE.
/// Print log (append-only). The first print of a document is the original,
/// every later one is a DUPLICATA.
model DocumentPrint {
  id        String      @id @default(uuid()) @db.Uuid
  /// Insertion order: decides which print came first, even within one millisecond.
  seq       BigInt      @unique @default(autoincrement())
  tenantId  String      @db.Uuid
  docType   DocType
  docId     String      @db.Uuid
  format    PrintFormat
  printedBy String?     @db.Uuid
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, docType, docId, seq])
  @@map("document_prints")
}

model DocumentSequence {
  tenantId   String  @db.Uuid
  docType    DocType
  year       Int     @db.SmallInt
  lastNumber Int     @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, docType, year])
  @@map("document_sequences")
}

model IdempotencyKey {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  key            String            @db.VarChar(100)
  method         String            @db.VarChar(10)
  path           String            @db.VarChar(255)
  /// sha256 of method + path + canonical JSON body.
  requestHash    String            @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @db.SmallInt
  responseBody   Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?         @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId, createdAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------- catalog (phase 2)

/// Product category. One level of nesting (enforced in CategoriesService).
/// Name uniqueness among live categories is checked in the service under a tenant lock.
model Category {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String    @db.VarChar(80)
  parentId  String?   @db.Uuid
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]          @relation("CategoryTree")
  products   Product[]
  warehouses WarehouseCategory[]

  @@index([tenantId, parentId])
  @@map("categories")
}

/// Tenant-level unit catalog. Default units have a stable code translated in the UI;
/// custom units have code CUSTOM-xxxx and a free-text name.
model Unit {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  code          String   @db.VarChar(40)
  name          String?  @db.VarChar(40)
  allowsDecimal Boolean
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  baseOf       Product[]
  productUnits ProductUnit[]

  @@unique([tenantId, code])
  @@map("units")
}

/// Price levels 1..5 (Gros, Demi-gros, Détail...). Only the first `priceLevelCount` are shown.
model PriceLevel {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  position  Int      @db.SmallInt
  name      String   @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  prices  ProductPrice[]
  clients Client[]

  @@unique([tenantId, position])
  @@map("price_levels")
}

/// Master data: archived with deletedAt, never deleted.
model Product {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  reference   String    @db.VarChar(40)
  designation String    @db.VarChar(160)
  categoryId  String?   @db.Uuid
  brandId     String?   @db.Uuid
  baseUnitId  String    @db.Uuid
  tvaRate     Decimal   @db.Decimal(5, 2)
  minStock    Decimal   @default(0) @db.Decimal(14, 3)
  /// Per base unit, for import cost allocation by weight / volume (phase 22).
  weightKg    Decimal?  @db.Decimal(12, 3)
  volumeM3    Decimal?  @db.Decimal(12, 4)
  active      Boolean   @default(true)
  /// Optimistic lock: every update must send the version it read.
  version     Int       @default(1)
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  tenant              Tenant                 @relation(fields: [tenantId], references: [id])
  category            Category?              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand               Brand?                 @relation(fields: [brandId], references: [id], onDelete: Restrict)
  baseUnit            Unit                   @relation(fields: [baseUnitId], references: [id])
  units               ProductUnit[]
  prices              ProductPrice[]
  stock               ProductStock?
  stockMovements      StockMovement[]
  inventoryLines      InventoryLine[]
  purchaseLines       PurchaseLine[]
  purchaseReturnLines PurchaseReturnLine[]
  saleLines           SaleLine[]
  warehouseStocks     WarehouseStock[]
  stockTransferLines  StockTransferLine[]
  orderLines          OrderLine[]
  importAllocations   ImportCostAllocation[]
  promotionProducts   PromotionProduct[]
  packagings          ProductPackaging[]

  @@unique([tenantId, reference])
  @@index([tenantId, designation])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@map("products")
}

/// A unit a product is sold or bought in (pièce, carton = 24...). The base unit has factor 1.
/// Removing a unit soft-deletes it and moves its barcode to deletedBarcode, freeing the code.
model ProductUnit {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  productId         String    @db.Uuid
  unitId            String    @db.Uuid
  factorToBase      Decimal   @db.Decimal(14, 3)
  barcode           String?   @db.VarChar(64)
  deletedBarcode    String?   @db.VarChar(64)
  isDefaultSale     Boolean   @default(false)
  isDefaultPurchase Boolean   @default(false)
  deletedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  product Product        @relation(fields: [productId], references: [id])
  unit    Unit           @relation(fields: [unitId], references: [id])
  prices  ProductPrice[]

  /// One barcode per tenant across all units (NULLs are allowed many times).
  @@unique([tenantId, barcode])
  @@unique([productId, unitId])
  @@map("product_units")
}

/// Current selling price HT for one product unit at one price level.
/// History lives in the audit log (old and new value on every change).
model ProductPrice {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  productId     String   @db.Uuid
  productUnitId String   @db.Uuid
  priceLevelId  String   @db.Uuid
  priceHt       Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id])
  priceLevel  PriceLevel  @relation(fields: [priceLevelId], references: [id])

  @@unique([productUnitId, priceLevelId])
  @@index([tenantId, productId])
  @@map("product_prices")
}

// ---------------------------------------------------------------- stock (phase 3)

enum StockMovementType {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  ADJUSTMENT
  INVENTORY
  /// Phase 15: the two halves of a transfer between warehouses, at the current CUMP.
  TRANSFER_OUT
  TRANSFER_IN
  /// Phase 22: a late import cost changes the stock value, not the quantity (qtyBase 0).
  COST_ADJUST
}

enum AdjustmentReason {
  CASSE
  PERTE
  ERREUR
  AUTRE
}

enum InventoryStatus {
  OPEN
  VALIDATED
  CANCELLED
}

/// Stock ledger. Append-only (tenant extension + DB trigger): never updated or deleted.
/// Written only through StockService.applyMovements, under the ProductStock row lock.
model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  /// Insertion order. Movements of one product are written under its row lock, so
  /// seq is their true order (createdAt is the transaction start, shared by a batch).
  seq          BigInt            @unique @default(autoincrement())
  tenantId     String            @db.Uuid
  productId    String            @db.Uuid
  type         StockMovementType
  /// Signed quantity in the product's base unit (+ in, - out).
  qtyBase      Decimal           @db.Decimal(14, 3)
  /// Cost of one base unit for entries (4 decimals, see docs: CUMP precision).
  unitCost     Decimal?          @db.Decimal(14, 4)
  /// COST_ADJUST only (phase 22): stock value added, CUMP moves by valueDelta / stock.
  valueDelta   Decimal?          @db.Decimal(14, 2)
  /// Stock and CUMP right after this movement (running balance of the stock card).
  balanceAfter Decimal           @db.Decimal(14, 3)
  avgCostAfter Decimal           @db.Decimal(14, 4)
  reason       AdjustmentReason?
  /// What caused the movement (Inventory, Purchase, Sale...) and its id.
  refType      String?           @db.VarChar(30)
  refId        String?           @db.Uuid
  note         String?           @db.VarChar(255)
  createdBy    String?           @db.Uuid
  /// Where the goods are (phase 15). Nullable until the contract release; the backfill
  /// sets the default MAIN warehouse on older rows (the only update the trigger allows).
  warehouseId  String?           @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId, seq])
  @@index([tenantId, productId, warehouseId, seq])
  @@index([tenantId, refType, refId])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

/// Cached stock level and CUMP per product, updated in the same transaction as the
/// movement and reconcilable from the ledger (GET /stock/reconcile).
model ProductStock {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  productId  String   @unique @db.Uuid
  qtyBase    Decimal  @default(0) @db.Decimal(14, 3)
  avgCost    Decimal  @default(0) @db.Decimal(14, 4)
  /// Opening stock is one-time; checked under the row lock.
  hasOpening Boolean  @default(false)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@map("product_stocks")
}

/// A physical stock count (inventaire). Validating writes INVENTORY movements for differences.
model Inventory {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  number      String          @db.VarChar(20)
  status      InventoryStatus @default(OPEN)
  /// The dépôt counted (phase 15); nullable until the contract release.
  warehouseId String?         @db.Uuid
  note        String?         @db.VarChar(255)
  createdBy   String?         @db.Uuid
  validatedBy String?         @db.Uuid
  validatedAt DateTime?       @db.Timestamptz(3)
  cancelledAt DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     InventoryLine[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@map("inventories")
}

model InventoryLine {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  inventoryId     String   @db.Uuid
  productId       String   @db.Uuid
  countedQtyBase  Decimal  @db.Decimal(14, 3)
  /// Frozen at validation (null while the count is open).
  expectedQtyBase Decimal? @db.Decimal(14, 3)
  diffQtyBase     Decimal? @db.Decimal(14, 3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  inventory Inventory @relation(fields: [inventoryId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([inventoryId, productId])
  @@index([tenantId, inventoryId])
  @@map("inventory_lines")
}

// ---------------------------------------------------------------- purchases (phase 4)

enum PurchaseStatus {
  DRAFT
  /// Phase 22: validated inside an open dossier d'importation; on the supplier account, not in stock yet.
  IN_TRANSIT
  VALIDATED
  CANCELLED
}

/// Master data: archived with deletedAt, never deleted.
model Supplier {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  /// Matches the Excel import (phase 21). Optional: suppliers created before have none.
  code      String?   @db.VarChar(30)
  name      String    @db.VarChar(120)
  phone     String?   @db.VarChar(40)
  address   String?   @db.VarChar(255)
  rc        String?   @db.VarChar(40)
  nif       String?   @db.VarChar(40)
  nis       String?   @db.VarChar(40)
  ai        String?   @db.VarChar(40)
  notes     String?   @db.VarChar(500)
  /// Currency of its BRs and account (phase 22). Changes only while the ledger is empty.
  currency  String    @default("DZD") @db.VarChar(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  purchases   Purchase[]
  importCosts ImportCost[]
  returns     PurchaseReturn[]
  ledger      SupplierLedgerEntry[]
  balance     SupplierBalance?
  payments    SupplierPayment[]
  brands      Brand[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("suppliers")
}

/// Supplier account entries (phase 21). Positive amounts mean we owe the supplier more.
enum SupplierLedgerType {
  OPENING
  PURCHASE
  PAYMENT
  RETURN
  ADJUST
  REVERSAL
  /// Phase 22: a cost line of a dossier d'importation (transitaire, transporteur...).
  IMPORT_COST
}

/// Dettes fournisseurs: append-only, like client_ledger_entries.
model SupplierLedgerEntry {
  id             String             @id @default(uuid()) @db.Uuid
  /// Insertion order (createdAt is shared by a transaction).
  seq            BigInt             @unique @default(autoincrement())
  tenantId       String             @db.Uuid
  supplierId     String             @db.Uuid
  type           SupplierLedgerType
  amount         Decimal            @db.Decimal(14, 2)
  /// Phase 22: the amount in the supplier's currency, null for DZD entries.
  currency       String             @default("DZD") @db.VarChar(3)
  amountCurrency Decimal?           @db.Decimal(14, 2)
  label          String             @db.VarChar(160)
  reason         String?            @db.VarChar(255)
  refType        String?            @db.VarChar(30)
  refId          String?            @db.Uuid
  createdBy      String?            @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([tenantId, supplierId, seq])
  @@index([tenantId, refType, refId])
  @@map("supplier_ledger_entries")
}

/// Cached sum of a supplier's ledger, updated in the same transaction as each entry.
model SupplierBalance {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  supplierId      String   @unique @db.Uuid
  balance         Decimal  @default(0) @db.Decimal(14, 2)
  /// Same balance in the supplier's currency (phase 22): sum of amountCurrency, 0 for DZD suppliers.
  balanceCurrency Decimal  @default(0) @db.Decimal(14, 2)
  hasOpening      Boolean  @default(false)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([tenantId, balance])
  @@map("supplier_balances")
}

enum SupplierPaymentStatus {
  VALID
  CANCELLED
}

/// Règlement fournisseur (RGF): money paid to a supplier.
model SupplierPayment {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @db.Uuid
  number         String                @db.VarChar(20)
  supplierId     String                @db.Uuid
  amount         Decimal               @db.Decimal(14, 2)
  /// Phase 22: a payment to a foreign supplier, in its currency at the bank rate.
  currency       String                @default("DZD") @db.VarChar(3)
  amountCurrency Decimal?              @db.Decimal(14, 2)
  exchangeRate   Decimal?              @db.Decimal(12, 6)
  mode           PaymentMode
  status         SupplierPaymentStatus @default(VALID)
  /// Cheque or transfer number.
  reference      String?               @db.VarChar(80)
  bank           String?               @db.VarChar(80)
  /// Cheque due date (échéance).
  dueDate        DateTime?             @db.Date
  note           String?               @db.VarChar(255)
  paidBy         String?               @db.Uuid
  paidAt         DateTime              @default(now()) @db.Timestamptz(3)
  /// Phase 26: the dépôt that paid (figures per dépôt); null = the dépôt principal's.
  warehouseId    String?               @db.Uuid
  /// The account it left (phase 34). Nullable until the contract release.
  cashAccountId  String?               @db.Uuid
  /// Paid at reception of this BR (phase 34): cancelled with it, never alone.
  purchaseId     String?               @unique @db.Uuid
  cancelReason   String?               @db.VarChar(255)
  cancelledBy    String?               @db.Uuid
  cancelledAt    DateTime?             @db.Timestamptz(3)
  version        Int                   @default(1)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  supplier    Supplier     @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  purchase    Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([tenantId, number])
  @@index([tenantId, supplierId])
  @@index([tenantId, paidAt])
  @@index([tenantId, cashAccountId])
  @@index([tenantId, warehouseId, paidAt])
  @@index([tenantId, mode, status, dueDate])
  @@map("supplier_payments")
}

/// Bon de réception. Only validation has effects (stock, CUMP); the number is
/// assigned at validation so abandoned drafts never consume one.
model Purchase {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @db.Uuid
  number            String?        @db.VarChar(20)
  supplierId        String         @db.Uuid
  status            PurchaseStatus @default(DRAFT)
  documentDate      DateTime       @db.Date
  supplierRef       String?        @db.VarChar(60)
  note              String?        @db.VarChar(255)
  totalHt           Decimal        @default(0) @db.Decimal(14, 2)
  totalTva          Decimal        @default(0) @db.Decimal(14, 2)
  totalTtc          Decimal        @default(0) @db.Decimal(14, 2)
  /// Paid at reception. Supplier accounts come in v1.1.
  paidAmount        Decimal        @default(0) @db.Decimal(14, 2)
  /// How the paid part leaves, on a draft (phase 34): validating makes it a règlement.
  paidMode          PaymentMode    @default(ESPECES)
  paidCashAccountId String?        @db.Uuid
  /// The dépôt the goods enter or leave (phase 15); nullable until the contract release.
  warehouseId       String?        @db.Uuid
  /// Phase 22: the supplier's currency and the bank rate (DZD per 1 unit). Totals stay in DZD.
  currency          String         @default("DZD") @db.VarChar(3)
  exchangeRate      Decimal        @default(1) @db.Decimal(12, 6)
  totalCurrency     Decimal?       @db.Decimal(14, 2)
  importFileId      String?        @db.Uuid
  version           Int            @default(1)
  createdBy         String?        @db.Uuid
  validatedBy       String?        @db.Uuid
  validatedAt       DateTime?      @db.Timestamptz(3)
  cancelledBy       String?        @db.Uuid
  cancelledAt       DateTime?      @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  importFile      ImportFile?      @relation(fields: [importFileId], references: [id], onDelete: Restrict)
  paidCashAccount CashAccount?     @relation(fields: [paidCashAccountId], references: [id], onDelete: Restrict)
  paidPayment     SupplierPayment?
  lines           PurchaseLine[]
  returns         PurchaseReturn[]

  @@unique([tenantId, number])
  @@index([tenantId, importFileId])
  @@index([tenantId, createdAt])
  @@index([tenantId, supplierId])
  @@index([tenantId, status, validatedAt])
  @@map("purchases")
}

/// A line keeps a frozen copy of the product as it was (AGENTS.md rule 9).
model PurchaseLine {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  purchaseId         String   @db.Uuid
  position           Int      @db.SmallInt
  productId          String   @db.Uuid
  unitId             String   @db.Uuid
  designation        String   @db.VarChar(160)
  unitCode           String   @db.VarChar(40)
  unitName           String?  @db.VarChar(40)
  factorToBase       Decimal  @db.Decimal(14, 3)
  tvaRate            Decimal  @db.Decimal(5, 2)
  qty                Decimal  @db.Decimal(14, 3)
  qtyBase            Decimal  @db.Decimal(14, 3)
  /// Cost HT of one `unitId`.
  unitCost           Decimal  @db.Decimal(14, 4)
  lineHt             Decimal  @db.Decimal(14, 2)
  /// Phase 22: the supplier's price of one `unitId` in the BR currency (null for DZD BRs).
  unitCostCurrency   Decimal? @db.Decimal(14, 4)
  /// Phase 22: coût de revient of one base unit, set when its dossier is closed.
  landedUnitCostBase Decimal? @db.Decimal(14, 4)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  purchase          Purchase               @relation(fields: [purchaseId], references: [id])
  product           Product                @relation(fields: [productId], references: [id])
  returnLines       PurchaseReturnLine[]
  importAllocations ImportCostAllocation[]

  @@index([tenantId, purchaseId])
  @@map("purchase_lines")
}

/// Retour fournisseur: a partial return of a validated bon de réception.
model PurchaseReturn {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  number      String   @db.VarChar(20)
  purchaseId  String   @db.Uuid
  supplierId  String   @db.Uuid
  /// The dépôt the goods enter or leave (phase 15); nullable until the contract release.
  warehouseId String?  @db.Uuid
  note        String?  @db.VarChar(255)
  totalHt     Decimal  @db.Decimal(14, 2)
  totalTva    Decimal  @db.Decimal(14, 2)
  totalTtc    Decimal  @db.Decimal(14, 2)
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  purchase  Purchase             @relation(fields: [purchaseId], references: [id])
  supplier  Supplier             @relation(fields: [supplierId], references: [id])
  warehouse Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     PurchaseReturnLine[]

  @@unique([tenantId, number])
  @@index([tenantId, purchaseId])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  returnId       String   @db.Uuid
  purchaseLineId String   @db.Uuid
  productId      String   @db.Uuid
  qty            Decimal  @db.Decimal(14, 3)
  qtyBase        Decimal  @db.Decimal(14, 3)
  unitCost       Decimal  @db.Decimal(14, 4)
  tvaRate        Decimal  @db.Decimal(5, 2)
  lineHt         Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  return       PurchaseReturn @relation(fields: [returnId], references: [id])
  purchaseLine PurchaseLine   @relation(fields: [purchaseLineId], references: [id])
  product      Product        @relation(fields: [productId], references: [id])

  @@index([tenantId, purchaseLineId])
  @@map("purchase_return_lines")
}

// ---------------------------------------------------------------- clients (phase 5)

enum ClientType {
  PARTICULIER
  PROFESSIONNEL
}

enum ClientLedgerType {
  OPENING
  SALE
  PAYMENT
  RETURN
  ADJUSTMENT
  REVERSAL
}

/// Master data: archived with deletedAt, never deleted.
model Client {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @db.Uuid
  code             String     @db.VarChar(30)
  name             String     @db.VarChar(160)
  type             ClientType @default(PARTICULIER)
  phone            String?    @db.VarChar(40)
  phone2           String?    @db.VarChar(40)
  address          String?    @db.VarChar(255)
  wilaya           String?    @db.VarChar(60)
  commune          String?    @db.VarChar(80)
  rc               String?    @db.VarChar(40)
  nif              String?    @db.VarChar(40)
  nis              String?    @db.VarChar(40)
  ai               String?    @db.VarChar(40)
  priceLevelId     String?    @db.Uuid
  /// Plafond de crédit; null = no limit.
  creditLimit      Decimal?   @db.Decimal(14, 2)
  notes            String?    @db.VarChar(500)
  active           Boolean    @default(true)
  /// Sales force (phase 14): the client's zone and the seller who follows him.
  sectorId         String?    @db.Uuid
  assignedSellerId String?    @db.Uuid
  /// Reference GPS point (phase 17). A seller moves it only through an approved request.
  lat              Decimal?   @db.Decimal(9, 6)
  lng              Decimal?   @db.Decimal(9, 6)
  /// `lat` / `lng` as double precision, GENERATED ALWAYS … STORED in the migration: the
  /// database keeps them, nothing writes them. Only raw SQL reads them (the lat/lng box of
  /// the client map): under row-level security an index is usable with float8 comparisons,
  /// not with numeric ones (REPORT-35, C-1). `dbgenerated` is how Prisma reads a generated
  /// column back: it keeps `migrate dev` from seeing a drift.
  latF             Float?     @default(dbgenerated("(lat)::double precision")) @map("lat_f") @ignore
  lngF             Float?     @default(dbgenerated("(lng)::double precision")) @map("lng_f") @ignore
  geoAccuracyM     Int?
  geoSetAt         DateTime?  @db.Timestamptz(3)
  geoSetBy         String?    @db.Uuid
  version          Int        @default(1)
  deletedAt        DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  tenant         Tenant                   @relation(fields: [tenantId], references: [id])
  priceLevel     PriceLevel?              @relation(fields: [priceLevelId], references: [id], onDelete: Restrict)
  sector         Sector?                  @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  assignedSeller User?                    @relation("ClientSeller", fields: [assignedSellerId], references: [id], onDelete: Restrict)
  ledger         ClientLedgerEntry[]
  balance        ClientBalance?
  sales          Sale[]
  payments       Payment[]
  routeStops     RouteStop[]
  visits         Visit[]
  orders         Order[]
  geoChecks      GeoCheck[]
  geoRequests    ClientGeoChangeRequest[]
  promotions     PromotionClient[]
  packaging      ClientPackagingEntry[]
  packagingBals  ClientPackagingBalance[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, phone])
  @@index([tenantId, sectorId])
  @@index([tenantId, assignedSellerId])
  /// Phase 35: clients_tenant_geo_f_idx ("tenantId", lat_f, lng_f) WHERE live and with a
  /// point, a partial index in the migration (Prisma cannot express it). The older
  /// clients_tenant_geo_idx on the numeric columns is unusable under RLS; to be dropped.
  @@map("clients")
}

/// Client account ledger. Append-only (tenant extension + DB trigger). Positive
/// amounts mean the client owes more. Written only through ClientAccountService.
model ClientLedgerEntry {
  id          String           @id @default(uuid()) @db.Uuid
  /// Insertion order (createdAt is shared by a transaction).
  seq         BigInt           @unique @default(autoincrement())
  tenantId    String           @db.Uuid
  clientId    String           @db.Uuid
  type        ClientLedgerType
  amount      Decimal          @db.Decimal(14, 2)
  label       String           @db.VarChar(160)
  reason      String?          @db.VarChar(255)
  refType     String?          @db.VarChar(30)
  refId       String?          @db.Uuid
  createdBy   String?          @db.Uuid
  /// The dépôt this debt or payment belongs to (phase 24); one client account across dépôts.
  /// Nullable until the contract release (db:backfill-units fills the old rows).
  warehouseId String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  client    Client     @relation(fields: [clientId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([tenantId, clientId, warehouseId])
  @@index([tenantId, clientId, seq])
  @@index([tenantId, refType, refId])
  @@map("client_ledger_entries")
}

/// Cached balance, updated in the same transaction as the entries and
/// reconcilable from the ledger (GET /clients/reconcile).
model ClientBalance {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  clientId   String   @unique @db.Uuid
  balance    Decimal  @default(0) @db.Decimal(14, 2)
  hasOpening Boolean  @default(false)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@index([tenantId, balance])
  @@map("client_balances")
}

// ---------------------------------------------------------------- sales

enum SaleType {
  BL
  FACTURE
}

enum SaleStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

enum PaymentMode {
  ESPECES
  CHEQUE
  VIREMENT
}

enum PaymentStatus {
  VALID
  CANCELLED
  BOUNCED
}

enum ReturnDisposition {
  RESTOCK
  DAMAGED
}

/// A sale document: bon de livraison or facture. A facture either sells directly
/// (stock + ledger effects) or groups validated BLs (`sourceBls`, no stock effect).
model Sale {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  type           SaleType
  number         String?      @db.VarChar(20)
  status         SaleStatus   @default(DRAFT)
  /// null = client comptoir: everything is paid at once, nothing goes on credit.
  clientId       String?      @db.Uuid
  /// Client name, address and legal IDs as they were at validation (printing).
  clientSnapshot Json?
  documentDate   DateTime     @db.Date
  priceLevelId   String?      @db.Uuid
  note           String?      @db.VarChar(255)
  /// The tenant's TVA regime when the sale was validated (frozen for returns).
  assujettiTva   Boolean      @default(true)
  totalHt        Decimal      @default(0) @db.Decimal(14, 2)
  totalTva       Decimal      @default(0) @db.Decimal(14, 2)
  totalTtc       Decimal      @default(0) @db.Decimal(14, 2)
  /// Timbre fiscal (factures paid in cash). Computed from phase 8; 0 until then.
  timbre         Decimal      @default(0) @db.Decimal(14, 2)
  /// Kept part of what was handed over (never more than TTC).
  paidAmount     Decimal      @default(0) @db.Decimal(14, 2)
  paymentMode    PaymentMode?
  /// Set on a BL once it is grouped in a facture.
  invoiceId      String?      @db.Uuid
  /// Validated over the plafond by a manager.
  creditOverride Boolean      @default(false)
  cancelReason   String?      @db.VarChar(255)
  version        Int          @default(1)
  createdBy      String?      @db.Uuid
  /// Who made the sale (phase 14); frozen at validation, changed only through a reassign.
  sellerId       String?      @db.Uuid
  /// The dépôt the goods enter or leave (phase 15); nullable until the contract release.
  /// On a draft: the dépôt chosen so far (null = decided at validation).
  warehouseId    String?      @db.Uuid
  validatedBy    String?      @db.Uuid
  validatedAt    DateTime?    @db.Timestamptz(3)
  cancelledBy    String?      @db.Uuid
  cancelledAt    DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  warehouse          Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  client             Client?             @relation(fields: [clientId], references: [id])
  seller             User?               @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  invoice            Sale?               @relation("InvoiceBls", fields: [invoiceId], references: [id])
  sourceBls          Sale[]              @relation("InvoiceBls")
  lines              SaleLine[]
  returns            SaleReturn[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  order              Order?

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@index([tenantId, clientId])
  @@index([tenantId, type, status])
  @@index([tenantId, invoiceId])
  /// Dashboard and reports: validated sales by validation time.
  @@index([tenantId, status, validatedAt])
  @@index([tenantId, sellerId, validatedAt])
  @@map("sales")
}

/// A line keeps a frozen copy of the product and the price as they were (AGENTS.md rule 9).
model SaleLine {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  saleId         String   @db.Uuid
  position       Int      @db.SmallInt
  productId      String   @db.Uuid
  unitId         String   @db.Uuid
  designation    String   @db.VarChar(160)
  unitCode       String   @db.VarChar(40)
  unitName       String?  @db.VarChar(40)
  factorToBase   Decimal  @db.Decimal(14, 3)
  qty            Decimal  @db.Decimal(14, 3)
  qtyBase        Decimal  @db.Decimal(14, 3)
  /// Price of the client's level when the line was entered (audit of overrides).
  listPriceHt    Decimal? @db.Decimal(14, 2)
  /// Price HT of one `unitId` actually charged.
  unitPriceHt    Decimal  @db.Decimal(14, 2)
  discountPct    Decimal  @default(0) @db.Decimal(5, 2)
  tvaRate        Decimal  @db.Decimal(5, 2)
  lineHt         Decimal  @db.Decimal(14, 2)
  /// CUMP of one base unit at validation (margin, and the value of returns).
  unitCostBase   Decimal  @default(0) @db.Decimal(14, 4)
  /// For facture lines copied from a BL line.
  sourceLineId   String?  @db.Uuid
  /// Promotions (phase 20): a free line (UG) is priced 0 and points to its paid line.
  isFree         Boolean  @default(false)
  promotionId    String?  @db.Uuid
  /// The promotion's name when the line was priced (frozen).
  promotionName  String?  @db.VarChar(80)
  /// Position of the paid line a free line comes from, in the same document.
  freeOfPosition Int?     @db.SmallInt
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  sale        Sale             @relation(fields: [saleId], references: [id])
  product     Product          @relation(fields: [productId], references: [id])
  returnLines SaleReturnLine[]

  @@index([tenantId, saleId])
  @@index([tenantId, productId])
  @@map("sale_lines")
}

/// Avoir: goods brought back by the client, at the frozen sale price.
model SaleReturn {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  number      String            @db.VarChar(20)
  saleId      String            @db.Uuid
  clientId    String?           @db.Uuid
  disposition ReturnDisposition
  reason      String            @db.VarChar(255)
  /// The dépôt the goods enter or leave (phase 15); nullable until the contract release.
  warehouseId String?           @db.Uuid
  totalHt     Decimal           @db.Decimal(14, 2)
  totalTva    Decimal           @db.Decimal(14, 2)
  totalTtc    Decimal           @db.Decimal(14, 2)
  createdBy   String?           @db.Uuid
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  sale      Sale             @relation(fields: [saleId], references: [id])
  warehouse Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     SaleReturnLine[]

  @@unique([tenantId, number])
  @@index([tenantId, saleId])
  @@index([tenantId, createdAt])
  @@map("sale_returns")
}

model SaleReturnLine {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  returnId    String   @db.Uuid
  saleLineId  String   @db.Uuid
  productId   String   @db.Uuid
  qty         Decimal  @db.Decimal(14, 3)
  qtyBase     Decimal  @db.Decimal(14, 3)
  unitPriceHt Decimal  @db.Decimal(14, 2)
  discountPct Decimal  @default(0) @db.Decimal(5, 2)
  tvaRate     Decimal  @db.Decimal(5, 2)
  lineHt      Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  return   SaleReturn @relation(fields: [returnId], references: [id])
  saleLine SaleLine   @relation(fields: [saleLineId], references: [id])

  @@index([tenantId, returnId])
  @@index([tenantId, saleLineId])
  @@map("sale_return_lines")
}

/// Versement: money received. Created at sale time for the paid part (also for
/// counter sales, without client); phase 7 adds standalone versements.
model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  number        String        @db.VarChar(20)
  clientId      String?       @db.Uuid
  saleId        String?       @db.Uuid
  amount        Decimal       @db.Decimal(14, 2)
  mode          PaymentMode
  status        PaymentStatus @default(VALID)
  /// Cheque or transfer number.
  reference     String?       @db.VarChar(80)
  bank          String?       @db.VarChar(80)
  /// Cheque due date (échéance).
  dueDate       DateTime?     @db.Date
  note          String?       @db.VarChar(255)
  receivedBy    String?       @db.Uuid
  /// Who collected the money from the client (phase 14); the receiver when he is a SELLER.
  collectedBy   String?       @db.Uuid
  receivedAt    DateTime      @default(now()) @db.Timestamptz(3)
  cancelReason  String?       @db.VarChar(255)
  cancelledBy   String?       @db.Uuid
  cancelledAt   DateTime?     @db.Timestamptz(3)
  bounceReason  String?       @db.VarChar(255)
  bouncedBy     String?       @db.Uuid
  bouncedAt     DateTime?     @db.Timestamptz(3)
  /// The dépôt the cash came in at (phase 24). Nullable until the contract release.
  warehouseId   String?       @db.Uuid
  /// The account it went into (phase 34). Nullable until the contract release.
  cashAccountId String?       @db.Uuid
  version       Int           @default(1)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  client      Client?             @relation(fields: [clientId], references: [id])
  sale        Sale?               @relation(fields: [saleId], references: [id])
  collector   User?               @relation("PaymentCollector", fields: [collectedBy], references: [id], onDelete: Restrict)
  warehouse   Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  cashAccount CashAccount?        @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, receivedAt])
  @@index([tenantId, clientId])
  @@index([tenantId, saleId])
  @@index([tenantId, mode, status, dueDate])
  @@index([tenantId, collectedBy, receivedAt])
  @@index([tenantId, warehouseId, receivedAt])
  @@index([tenantId, cashAccountId])
  @@map("payments")
}

/// Which documents a versement pays. Informational: feeds "reste à payer" and
/// aging; the client balance is the ledger and never depends on it.
model PaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  paymentId String   @db.Uuid
  saleId    String   @db.Uuid
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])
  sale    Sale    @relation(fields: [saleId], references: [id])

  @@unique([paymentId, saleId])
  @@index([tenantId, saleId])
  @@index([tenantId, paymentId])
  @@map("payment_allocations")
}

// ---------------------------------------------------------------- imports

enum ImportType {
  PRODUCTS
  OPENING_STOCK
  CLIENTS
  /// Fournisseurs et soldes (phase 21).
  SUPPLIERS
  /// Emballages chez les clients, opening counts (phase 20).
  PACKAGING_OPENING
  /// Personnel, with opening congé and avance balances (phase 31).
  EMPLOYEES
}

enum ImportStatus {
  PREVIEWED
  COMPLETED
  FAILED
}

/// One Excel/CSV import (preview, then confirm). Kept for audit; the file itself
/// is dropped after its retention period (fileData set to null).
model ImportJob {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  type          ImportType
  status        ImportStatus @default(PREVIEWED)
  fileName      String       @db.VarChar(255)
  fileMime      String       @db.VarChar(120)
  fileData      Bytes?
  fileExpiresAt DateTime     @db.Timestamptz(3)
  /// Field key -> column index used by the last preview and the confirm.
  mapping       Json         @default("{}")
  totalRows     Int          @default(0)
  errorRows     Int          @default(0)
  warningRows   Int          @default(0)
  createdRows   Int          @default(0)
  updatedRows   Int          @default(0)
  openingRows   Int          @default(0)
  /// First row errors of the last preview or failed confirm, for the history screen.
  errors        Json         @default("[]")
  createdBy     String?      @db.Uuid
  confirmedAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([fileExpiresAt])
  @@map("import_jobs")
}

// ---------------------------------------------------------------------------
// Phase 13: plans, subscriptions, super-admin
// ---------------------------------------------------------------------------

/// Stored statuses only. PAST_DUE and SUSPENDED are derived from currentPeriodEnd
/// (packages/shared/subscription.ts), so no job has to move a tenant between them.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
}

enum SubscriptionPaymentMethod {
  BARIDIMOB
  VIREMENT
  ESPECES
}

/// Global (not tenant-scoped). Null limits mean unlimited.
model Plan {
  id                   String   @id @default(uuid()) @db.Uuid
  code                 String   @unique @db.VarChar(30)
  name                 String   @db.VarChar(60)
  monthlyPrice         Decimal  @db.Decimal(14, 2)
  maxUsers             Int?
  maxProducts          Int?
  /// Soft limit: going over only warns.
  maxDocumentsPerMonth Int?
  /// Sellers on the mobile app (phase 19).
  maxMobileSellers     Int?
  /// Assistant questions per month on the platform key (phase 30). Null: unlimited.
  aiQuestionsPerMonth  Int?
  active               Boolean  @default(true)
  sortOrder            Int      @default(0) @db.SmallInt
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plans")
}

enum Edition {
  ESSENTIEL
  IMPORT
  DISTRIBUTION
  ENTREPRISE
}

/// What each edition adds to the plan's monthly price (phase 13b). Platform data, like plans.
model EditionPrice {
  edition           Edition  @id
  monthlySupplement Decimal  @db.Decimal(14, 2)
  sortOrder         Int      @default(0) @db.SmallInt
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  @@map("edition_prices")
}

/// One per tenant. Changed only by registration and the super-admin.
model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @unique @db.Uuid
  planId           String             @db.Uuid
  status           SubscriptionStatus
  /// The modules (phase 13b). The plan sets the price and the limits.
  edition          Edition            @default(ESSENTIEL)
  /// Pilot tenant: never billed, never suspended.
  isFree           Boolean            @default(false)
  trialEndsAt      DateTime?          @db.Timestamptz(3)
  currentPeriodEnd DateTime           @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

/// A payment recorded by the super-admin (manual: BaridiMob, virement, espèces). Append-only.
model SubscriptionPayment {
  id             String                    @id @default(uuid()) @db.Uuid
  tenantId       String                    @db.Uuid
  amount         Decimal                   @db.Decimal(14, 2)
  method         SubscriptionPaymentMethod
  reference      String?                   @db.VarChar(80)
  months         Int                       @db.SmallInt
  periodFrom     DateTime                  @db.Timestamptz(3)
  periodTo       DateTime                  @db.Timestamptz(3)
  planId         String                    @db.Uuid
  adminId        String                    @db.Uuid
  idempotencyKey String                    @unique @db.VarChar(100)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  admin  PlatformAdmin @relation(fields: [adminId], references: [id])

  @@index([tenantId, createdAt])
  @@map("subscription_payments")
}

/// Super-admin: outside every tenant. Created with the admin:create CLI; login needs TOTP.
model PlatformAdmin {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.VarChar(254)
  fullName         String    @db.VarChar(120)
  passwordHash     String    @db.VarChar(255)
  /// Base32 TOTP secret (RFC 6238).
  totpSecret       String    @db.VarChar(64)
  failedLoginCount Int       @default(0) @db.SmallInt
  lockedUntil      DateTime? @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  sessions PlatformAdminSession[]
  payments SubscriptionPayment[]

  @@map("platform_admins")
}

model PlatformAdminSession {
  id                       String    @id @default(uuid()) @db.Uuid
  adminId                  String    @db.Uuid
  refreshTokenHash         String    @db.Char(64)
  previousRefreshTokenHash String?   @db.Char(64)
  rotatedAt                DateTime? @db.Timestamptz(3)
  userAgent                String?   @db.VarChar(255)
  ip                       String?   @db.VarChar(45)
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt               DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt                DateTime  @db.Timestamptz(3)
  revokedAt                DateTime? @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id])

  @@index([adminId, revokedAt])
  @@map("platform_admin_sessions")
}

/// Every super-admin action, including each request made while impersonating. Append-only.
model PlatformAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String?  @db.Uuid
  sessionId String?  @db.Uuid
  tenantId  String?  @db.Uuid
  action    String   @db.VarChar(60)
  detail    Json?
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@map("platform_audit_logs")
}

/// What a share link opens (phase 21).
enum ShareDocType {
  /// Relevé de compte of a client; the range is in `params`.
  RELEVE
  FACTURE
}

/// A signed, expiring link to one document, opened without login. Only the token's hash is kept.
model ShareLink {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  docType      ShareDocType
  docId        String       @db.Uuid
  /// RELEVE: { from, to }.
  params       Json         @default("{}")
  /// SHA-256 of the token, hex.
  tokenHash    String       @unique @db.VarChar(64)
  expiresAt    DateTime     @db.Timestamptz(3)
  revokedAt    DateTime?    @db.Timestamptz(3)
  revokedBy    String?      @db.Uuid
  createdBy    String?      @db.Uuid
  openCount    Int          @default(0)
  lastOpenedAt DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, docType, docId])
  @@map("share_links")
}

// ---------------------------------------------------------------- sales force (phase 14)

/// Marque. Core master data; names unique per tenant, case-insensitive (checked in the service).
model Brand {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  name       String    @db.VarChar(80)
  supplierId String?   @db.Uuid
  deletedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  supplier   Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  products   Product[]
  warehouses WarehouseBrand[]

  @@index([tenantId, name])
  @@map("brands")
}

/// Secteur: a zone (wilaya + communes) clients belong to. SALES_FORCE.
model Sector {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String    @db.VarChar(80)
  wilaya    String?   @db.VarChar(60)
  communes  String[]  @default([])
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  clients Client[]

  @@index([tenantId, name])
  @@map("sectors")
}

// ---------------------------------------------------------------- warehouses (phase 15)

enum WarehouseType {
  MAIN
  SECONDARY
  /// A truck: a seller's stock on the road (chargement / déchargement).
  VEHICLE
}

enum StockTransferType {
  /// Chargement: dépôt → camion.
  LOAD
  /// Déchargement: camion → dépôt.
  UNLOAD
  /// Any other move between two dépôts.
  TRANSFER
}

enum StockTransferStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

/// A dépôt or a truck (master data: archived, never deleted). Each tenant has exactly one
/// default MAIN warehouse (partial unique index), created at signup or on first use.
model Warehouse {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  name              String        @db.VarChar(80)
  type              WarehouseType
  /// The seller who drives this truck (VEHICLE only); one active truck per user.
  assignedUserId    String?       @db.Uuid
  isDefault         Boolean       @default(false)
  active            Boolean       @default(true)
  /// The dépôt's manager (phase 24, MULTI_UNIT).
  managerUserId     String?       @db.Uuid
  /// A truck belongs to one dépôt (MAIN / SECONDARY) and inherits its team and brands.
  parentWarehouseId String?       @db.Uuid
  /// The point self check-ins are measured from (phase 31); radius overrides geoRadiusM.
  lat               Decimal?      @db.Decimal(9, 6)
  lng               Decimal?      @db.Decimal(9, 6)
  radiusM           Int?          @db.SmallInt
  deletedAt         DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  employees        Employee[]
  assignedUser     User?                 @relation("WarehouseDriver", fields: [assignedUserId], references: [id], onDelete: Restrict)
  manager          User?                 @relation("WarehouseManager", fields: [managerUserId], references: [id], onDelete: Restrict)
  parent           Warehouse?            @relation("WarehouseTrucks", fields: [parentWarehouseId], references: [id], onDelete: Restrict)
  trucks           Warehouse[]           @relation("WarehouseTrucks")
  brands           WarehouseBrand[]
  categories       WarehouseCategory[]
  access           UserWarehouseAccess[]
  payments         Payment[]
  ledgerEntries    ClientLedgerEntry[]
  stocks           WarehouseStock[]
  movements        StockMovement[]
  purchases        Purchase[]
  purchaseReturns  PurchaseReturn[]
  sales            Sale[]
  saleReturns      SaleReturn[]
  inventories      Inventory[]
  transfersOut     StockTransfer[]       @relation("TransferFrom")
  transfersIn      StockTransfer[]       @relation("TransferTo")
  orders           Order[]
  sellerSessions   SellerSession[]
  expenses         Expense[]
  payrollRuns      PayrollRun[]
  rentContracts    RentContract[]
  supplierPayments SupplierPayment[]
  cashAccounts     CashAccount[]

  @@unique([tenantId, name])
  @@index([tenantId, type])
  @@index([tenantId, parentWarehouseId])
  @@map("warehouses")
}

enum WarehouseAccessLevel {
  /// Works there: sells, receives, sees its documents.
  OPERATE
  /// Sees its aggregated figures only (dashboard, reports), never a single document.
  VIEW_STATS
}

/// Where a user may work or look (phase 24, MULTI_UNIT). The owner and users with
/// VIEW_ALL_WAREHOUSES need no row. Trucks follow their parent dépôt.
model UserWarehouseAccess {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @db.Uuid
  userId      String               @db.Uuid
  warehouseId String               @db.Uuid
  level       WarehouseAccessLevel
  grantedBy   String?              @db.Uuid
  grantedAt   DateTime             @default(now()) @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  user      User      @relation("AccessUser", fields: [userId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([userId, warehouseId])
  @@index([tenantId, warehouseId])
  @@map("user_warehouse_access")
}

/// The brands a dépôt sells (phase 24). None = every brand.
model WarehouseBrand {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  warehouseId String @db.Uuid
  brandId     String @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, brandId])
  @@index([tenantId, warehouseId])
  @@map("warehouse_brands")
}

/// The categories a dépôt sells, sub-categories included (phase 24). None = every category.
model WarehouseCategory {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  warehouseId String @db.Uuid
  categoryId  String @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, categoryId])
  @@index([tenantId, warehouseId])
  @@map("warehouse_categories")
}

/// Quantity of a product in one warehouse. Written only by StockService.applyMovements,
/// under the ProductStock lock, in the same transaction as the movement:
/// SUM(qtyBase) over the warehouses of a product = ProductStock.qtyBase, always.
/// The CUMP stays on ProductStock (one per product for the whole company).
model WarehouseStock {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  warehouseId String   @db.Uuid
  productId   String   @db.Uuid
  qtyBase     Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@index([tenantId, productId])
  @@map("warehouse_stocks")
}

/// Bon de chargement / déchargement / transfert (TR-YYYY-000001). Validating writes a
/// TRANSFER_OUT and a TRANSFER_IN per line; cancelling a validated one writes the
/// reverse movements. Never deleted.
model StockTransfer {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @db.Uuid
  /// Given at validation (no gaps from drafts).
  number          String?             @db.VarChar(20)
  type            StockTransferType
  status          StockTransferStatus @default(DRAFT)
  fromWarehouseId String              @db.Uuid
  toWarehouseId   String              @db.Uuid
  note            String?             @db.VarChar(255)
  createdBy       String?             @db.Uuid
  validatedBy     String?             @db.Uuid
  validatedAt     DateTime?           @db.Timestamptz(3)
  cancelledBy     String?             @db.Uuid
  cancelledAt     DateTime?           @db.Timestamptz(3)
  cancelReason    String?             @db.VarChar(255)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  lines         StockTransferLine[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  transferId String   @db.Uuid
  productId  String   @db.Uuid
  /// What was typed (e.g. 5 cartons), kept for the printed bon.
  unitId     String   @db.Uuid
  qty        Decimal  @db.Decimal(14, 3)
  qtyBase    Decimal  @db.Decimal(14, 3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  transfer StockTransfer @relation(fields: [transferId], references: [id])
  product  Product       @relation(fields: [productId], references: [id])

  @@unique([transferId, productId])
  @@index([tenantId, transferId])
  @@map("stock_transfer_lines")
}

// ---------------------------------------------------------------- tournées (phase 16, TOURNEES)

enum VisitOutcome {
  SALE
  ORDER
  PAYMENT_ONLY
  NO_SALE
}

enum NoSaleReason {
  CLOSED
  HAS_STOCK
  NO_MONEY
  REFUSED
  OTHER
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum SellerSessionStatus {
  OPEN
  CLOSED
  ADJUST
}

/// Tournée: the clients a seller visits, in order, on given weekdays (master data).
model Route {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String    @db.VarChar(80)
  sellerId  String    @db.Uuid
  /// 0 = Sunday … 6 = Saturday, Africa/Algiers.
  weekdays  Int[]     @db.SmallInt
  active    Boolean   @default(true)
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  seller User        @relation("RouteSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  stops  RouteStop[]
  visits Visit[]

  @@index([tenantId, sellerId])
  @@map("routes")
}

model RouteStop {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  routeId   String   @db.Uuid
  clientId  String   @db.Uuid
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  route  Route  @relation(fields: [routeId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@unique([routeId, clientId])
  @@index([tenantId, routeId, position])
  @@index([tenantId, clientId])
  @@map("route_stops")
}

/// One stop at a client. Append-only: a correction is a new row with `correctsVisitId`.
model Visit {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  sellerId        String        @db.Uuid
  clientId        String        @db.Uuid
  routeId         String?       @db.Uuid
  startedAt       DateTime      @db.Timestamptz(3)
  endedAt         DateTime?     @db.Timestamptz(3)
  outcome         VisitOutcome
  reason          NoSaleReason?
  note            String?       @db.VarChar(255)
  saleId          String?       @db.Uuid
  orderId         String?       @db.Uuid
  paymentId       String?       @db.Uuid
  correctsVisitId String?       @unique @db.Uuid
  createdBy       String?       @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  seller      User   @relation("VisitSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  client      Client @relation(fields: [clientId], references: [id])
  route       Route? @relation(fields: [routeId], references: [id])
  corrects    Visit? @relation("VisitCorrection", fields: [correctsVisitId], references: [id])
  correctedBy Visit? @relation("VisitCorrection")

  @@index([tenantId, sellerId, startedAt])
  @@index([tenantId, clientId, startedAt])
  @@map("visits")
}

/// Bon de commande (pré-vente). No stock or ledger effect: delivering it creates the BL.
model Order {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  /// Given at confirmation (no gaps from drafts).
  number        String?     @db.VarChar(20)
  status        OrderStatus @default(DRAFT)
  clientId      String      @db.Uuid
  sellerId      String?     @db.Uuid
  /// Dépôt to deliver from; null = the livreur's truck, else MAIN, decided at delivery.
  warehouseId   String?     @db.Uuid
  livreurId     String?     @db.Uuid
  requestedDate DateTime?   @db.Date
  priceLevelId  String?     @db.Uuid
  note          String?     @db.VarChar(255)
  assujettiTva  Boolean     @default(true)
  totalHt       Decimal     @default(0) @db.Decimal(14, 2)
  totalTva      Decimal     @default(0) @db.Decimal(14, 2)
  totalTtc      Decimal     @default(0) @db.Decimal(14, 2)
  /// The BL made at delivery; one order gives at most one BL.
  saleId        String?     @unique @db.Uuid
  version       Int         @default(1)
  createdBy     String?     @db.Uuid
  confirmedBy   String?     @db.Uuid
  confirmedAt   DateTime?   @db.Timestamptz(3)
  deliveredBy   String?     @db.Uuid
  deliveredAt   DateTime?   @db.Timestamptz(3)
  cancelledBy   String?     @db.Uuid
  cancelledAt   DateTime?   @db.Timestamptz(3)
  cancelReason  String?     @db.VarChar(255)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  client    Client      @relation(fields: [clientId], references: [id])
  seller    User?       @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  livreur   User?       @relation("OrderLivreur", fields: [livreurId], references: [id], onDelete: Restrict)
  warehouse Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  sale      Sale?       @relation(fields: [saleId], references: [id])
  lines     OrderLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status, requestedDate])
  @@index([tenantId, sellerId, createdAt])
  @@index([tenantId, livreurId, status])
  @@index([tenantId, clientId])
  @@map("orders")
}

/// Frozen like a sale line at confirmation (rule 9); a draft line is replaced freely.
model OrderLine {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  orderId         String   @db.Uuid
  position        Int      @db.SmallInt
  productId       String   @db.Uuid
  unitId          String   @db.Uuid
  designation     String   @db.VarChar(160)
  unitCode        String   @db.VarChar(40)
  unitName        String?  @db.VarChar(40)
  factorToBase    Decimal  @db.Decimal(14, 3)
  qty             Decimal  @db.Decimal(14, 3)
  qtyBase         Decimal  @db.Decimal(14, 3)
  listPriceHt     Decimal? @db.Decimal(14, 2)
  unitPriceHt     Decimal  @db.Decimal(14, 2)
  discountPct     Decimal  @default(0) @db.Decimal(5, 2)
  tvaRate         Decimal  @db.Decimal(5, 2)
  lineHt          Decimal  @db.Decimal(14, 2)
  /// Set at delivery, in the line's unit: delivered + not delivered = qty.
  qtyDelivered    Decimal? @db.Decimal(14, 3)
  qtyNotDelivered Decimal? @db.Decimal(14, 3)
  /// Promotions (phase 20): a free line (UG) is priced 0 and points to its paid line.
  isFree          Boolean  @default(false)
  promotionId     String?  @db.Uuid
  /// The promotion's name when the line was priced (frozen).
  promotionName   String?  @db.VarChar(80)
  /// Position of the paid line a free line comes from, in the same document.
  freeOfPosition  Int?     @db.SmallInt
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, productId])
  @@map("order_lines")
}

/// Clôture de tournée: one per seller per day (partial unique index in the migration).
/// CLOSED is final; an ADJUST row points to it with `adjustsSessionId`.
model SellerSession {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  sellerId         String              @db.Uuid
  date             DateTime            @db.Date
  warehouseId      String?             @db.Uuid
  status           SellerSessionStatus @default(OPEN)
  /// Computed by the API at closing, never typed.
  expectedCash     Decimal?            @db.Decimal(14, 2)
  cashFromSales    Decimal?            @db.Decimal(14, 2)
  cashFromPayments Decimal?            @db.Decimal(14, 2)
  handedCash       Decimal?            @db.Decimal(14, 2)
  /// handed − expected; negative = cash missing.
  ecart            Decimal?            @db.Decimal(14, 2)
  note             String?             @db.VarChar(255)
  adjustsSessionId String?             @db.Uuid
  createdBy        String?             @db.Uuid
  closedBy         String?             @db.Uuid
  closedAt         DateTime?           @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  seller      User            @relation("SessionSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  adjusts     SellerSession?  @relation("SessionAdjust", fields: [adjustsSessionId], references: [id])
  adjustments SellerSession[] @relation("SessionAdjust")

  @@index([tenantId, date])
  @@index([tenantId, sellerId, date])
  @@map("seller_sessions")
}

// ---------------------------------------------------------------- géolocalisation (phase 17)

enum GeoCheckMode {
  OFF
  FLAG
  BLOCK
}

enum GeoStatus {
  NO_SIGNAL
  MOCKED
  LOW_ACCURACY
  NO_CLIENT_GPS
  OK
  FAR
}

enum GeoRefType {
  SALE
  PAYMENT
  VISIT
  /// A self check-in or check-out (phase 31).
  ATTENDANCE
}

enum GeoReviewStatus {
  NONE
  JUSTIFIED
  NOT_JUSTIFIED
}

enum GeoChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Where the device was when a sale, versement or visit was saved, and what the API
/// concluded. One row per document, written in the document's transaction. Only the
/// cached review fields change, together with a GeoCheckReview row.
model GeoCheck {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @db.Uuid
  refType      GeoRefType
  refId        String          @db.Uuid
  /// Number of the sale or versement at check time; null for a visit.
  refNumber    String?         @db.VarChar(20)
  clientId     String?         @db.Uuid
  userId       String?         @db.Uuid
  lat          Decimal?        @db.Decimal(9, 6)
  lng          Decimal?        @db.Decimal(9, 6)
  accuracyM    Int?
  isMocked     Boolean         @default(false)
  /// Device clock.
  capturedAt   DateTime?       @db.Timestamptz(3)
  receivedAt   DateTime        @default(now()) @db.Timestamptz(3)
  /// The client's point the distance was measured from (it may move later).
  clientLat    Decimal?        @db.Decimal(9, 6)
  clientLng    Decimal?        @db.Decimal(9, 6)
  distanceM    Int?
  status       GeoStatus
  flags        String[]        @default([])
  note         String?         @db.VarChar(255)
  reviewStatus GeoReviewStatus @default(NONE)
  reviewedBy   String?         @db.Uuid
  reviewedAt   DateTime?       @db.Timestamptz(3)

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  client  Client?          @relation(fields: [clientId], references: [id])
  reviews GeoCheckReview[]

  @@unique([tenantId, refType, refId])
  @@index([tenantId, receivedAt])
  @@index([tenantId, userId, receivedAt])
  @@index([tenantId, status, reviewStatus])
  @@map("geo_checks")
}

/// A manager's verdict on a GeoCheck. Append-only (tenant extension + DB trigger).
model GeoCheckReview {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String          @db.Uuid
  geoCheckId String          @db.Uuid
  verdict    GeoReviewStatus
  note       String?         @db.VarChar(255)
  reviewedBy String          @db.Uuid
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  geoCheck GeoCheck @relation(fields: [geoCheckId], references: [id])

  @@index([tenantId, geoCheckId, createdAt])
  @@map("geo_check_reviews")
}

/// A seller asks to move a client's saved point; a manager or his supervisor decides.
model ClientGeoChangeRequest {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @db.Uuid
  clientId     String                 @db.Uuid
  lat          Decimal                @db.Decimal(9, 6)
  lng          Decimal                @db.Decimal(9, 6)
  accuracyM    Int?
  /// The client's point when the request was made.
  previousLat  Decimal?               @db.Decimal(9, 6)
  previousLng  Decimal?               @db.Decimal(9, 6)
  note         String?                @db.VarChar(255)
  status       GeoChangeRequestStatus @default(PENDING)
  requestedBy  String                 @db.Uuid
  decidedBy    String?                @db.Uuid
  decidedAt    DateTime?              @db.Timestamptz(3)
  rejectReason String?                @db.VarChar(255)
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([tenantId, clientId, createdAt])
  @@map("client_geo_change_requests")
}

// ---------------------------------------------------------------- objectifs & primes (phase 18)

enum IncentivePeriod {
  MONTH
  QUARTER
}

enum IncentivePlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum IncentiveAppliesTo {
  ROLE
  USER
  TEAM_MANAGER
}

enum IncentiveRunStatus {
  PREVIEW
  APPROVED
  EXPORTED
}

/// A monthly target of a seller (userId) or of a manager's whole team (teamManagerId),
/// on one figure, maybe limited to a brand / category / product. One per subject, month,
/// metric and scope (unique index in the migration).
model SalesTarget {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  /// First day of the month (Algiers).
  periodStart   DateTime @db.Date
  userId        String?  @db.Uuid
  teamManagerId String?  @db.Uuid
  /// IncentiveMetric (packages/shared/incentives.ts).
  metric        String   @db.VarChar(30)
  /// `scopeKey(scope)`, '' when the target is on the whole figure.
  scopeKey      String   @default("") @db.VarChar(160)
  brandId       String?  @db.Uuid
  categoryId    String?  @db.Uuid
  productId     String?  @db.Uuid
  targetValue   Decimal  @db.Decimal(16, 3)
  createdBy     String?  @db.Uuid
  updatedBy     String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, periodStart])
  @@map("sales_targets")
}

/// A bonus plan. An ACTIVE plan is never edited: a change is a new version (same
/// familyId, version + 1) with its own validFrom; activating it closes the previous one.
model IncentivePlan {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @db.Uuid
  familyId  String              @db.Uuid
  version   Int                 @default(1)
  name      String              @db.VarChar(80)
  period    IncentivePeriod     @default(MONTH)
  validFrom DateTime            @db.Date
  validTo   DateTime?           @db.Date
  status    IncentivePlanStatus @default(DRAFT)
  createdBy String?             @db.Uuid
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @db.Timestamptz(3)

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  rules  IncentiveRule[]
  runs   IncentiveRun[]

  @@unique([tenantId, familyId, version])
  @@index([tenantId, status])
  @@map("incentive_plans")
}

/// One rule of a plan. `params` is IncentiveRuleParams (zod union in packages/shared).
model IncentiveRule {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  planId       String             @db.Uuid
  position     Int                @db.SmallInt
  name         String             @db.VarChar(80)
  appliesTo    IncentiveAppliesTo
  /// A role for ROLE, a user id for USER / TEAM_MANAGER.
  roleOrUserId String             @db.VarChar(40)
  params       Json
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  plan   IncentivePlan   @relation(fields: [planId], references: [id])
  lines  IncentiveLine[]

  @@index([tenantId, planId])
  @@map("incentive_rules")
}

/// The bonuses of one plan for one period. A PREVIEW is recomputed at will (its lines are
/// replaced); APPROVED is frozen (DB trigger) and only moves to EXPORTED.
model IncentiveRun {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  planId      String             @db.Uuid
  periodStart DateTime           @db.Date
  /// Last day included.
  periodEnd   DateTime           @db.Date
  status      IncentiveRunStatus @default(PREVIEW)
  computedAt  DateTime           @db.Timestamptz(3)
  computedBy  String?            @db.Uuid
  approvedBy  String?            @db.Uuid
  approvedAt  DateTime?          @db.Timestamptz(3)
  exportedAt  DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  plan   IncentivePlan   @relation(fields: [planId], references: [id])
  lines  IncentiveLine[]

  @@index([tenantId, planId, periodStart])
  @@index([tenantId, status, periodStart])
  @@map("incentive_runs")
}

/// What one rule paid one user in a run, with the figures and the explanation.
model IncentiveLine {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  runId       String   @db.Uuid
  userId      String   @db.Uuid
  ruleId      String   @db.Uuid
  /// The figures read (by metricKey), frozen.
  metrics     Json
  target      Decimal? @db.Decimal(16, 3)
  amount      Decimal  @db.Decimal(14, 2)
  /// RuleExplanation (packages/shared/incentives.ts).
  explanation Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  run    IncentiveRun  @relation(fields: [runId], references: [id])
  rule   IncentiveRule @relation(fields: [ruleId], references: [id])

  @@index([tenantId, runId])
  @@index([tenantId, userId])
  @@map("incentive_lines")
}

// ---------------------------------------------------------------- phase 22: importateur

enum ImportFileStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ImportCostType {
  FRET
  DOUANE
  /// TVA à l'importation: a cost only for non-assujetti tenants.
  TVA_IMPORT
  TRANSITAIRE
  MAGASINAGE
  TRANSPORT
  ASSURANCE
  AUTRE
}

enum AllocationMethod {
  VALUE
  QUANTITY
  WEIGHT
  VOLUME
  MANUAL
}

/// Dossier d'importation: one shipment (container) grouping BRs and their costs.
model ImportFile {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  number      String           @db.VarChar(20)
  status      ImportFileStatus @default(OPEN)
  /// B/L, LTA or the importer's own reference.
  reference   String?          @db.VarChar(60)
  containerNo String?          @db.VarChar(40)
  arrivalDate DateTime?        @db.Date
  note        String?          @db.VarChar(255)
  version     Int              @default(1)
  createdBy   String?          @db.Uuid
  closedBy    String?          @db.Uuid
  closedAt    DateTime?        @db.Timestamptz(3)
  cancelledBy String?          @db.Uuid
  cancelledAt DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  purchases Purchase[]
  costs     ImportCost[]

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@map("import_files")
}

/// A cost of a dossier (fret, douane...). Cancelled, never deleted.
model ImportCost {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  importFileId   String           @db.Uuid
  type           ImportCostType
  label          String?          @db.VarChar(120)
  /// The transitaire / transporteur we owe it to; its account is posted when the cost is added.
  supplierId     String?          @db.Uuid
  currency       String           @default("DZD") @db.VarChar(3)
  amountCurrency Decimal?         @db.Decimal(14, 2)
  exchangeRate   Decimal          @default(1) @db.Decimal(12, 6)
  /// What we owe, in DZD (TVA included).
  amount         Decimal          @db.Decimal(14, 2)
  /// The TVA inside `amount`: recoverable when the tenant is assujetti, so not in the cost.
  tvaAmount      Decimal          @default(0) @db.Decimal(14, 2)
  method         AllocationMethod
  /// MANUAL only: { purchaseLineId: amount } summing to the allocated amount.
  manualSplit    Json?
  /// Added after the dossier was closed (COST_ADJUST).
  isLate         Boolean          @default(false)
  /// Paid now from this account (phase 34): a cost without a supplier, like the douane.
  cashAccountId  String?          @db.Uuid
  paidMode       PaymentMode?
  /// The Algiers day the money left.
  paidDate       DateTime?        @db.Date
  createdBy      String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  cancelledBy    String?          @db.Uuid
  cancelledAt    DateTime?        @db.Timestamptz(3)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  importFile  ImportFile             @relation(fields: [importFileId], references: [id])
  supplier    Supplier?              @relation(fields: [supplierId], references: [id])
  cashAccount CashAccount?           @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  allocations ImportCostAllocation[]

  @@index([tenantId, importFileId])
  @@index([tenantId, cashAccountId, paidDate])
  @@map("import_costs")
}

/// Frozen share of a cost on one BR line, written at close (or with a late cost). Append-only.
model ImportCostAllocation {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  importCostId   String   @db.Uuid
  purchaseLineId String   @db.Uuid
  productId      String   @db.Uuid
  amount         Decimal  @db.Decimal(14, 2)
  /// Late costs: the part that went into the stock value (COST_ADJUST) ...
  stockValue     Decimal  @default(0) @db.Decimal(14, 2)
  /// ... and the part for units already sold (écart de coût in the margin report).
  ecart          Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  importCost   ImportCost   @relation(fields: [importCostId], references: [id])
  purchaseLine PurchaseLine @relation(fields: [purchaseLineId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@index([tenantId, importCostId])
  @@index([tenantId, productId, createdAt])
  @@map("import_cost_allocations")
}

// ---------------------------------------------------------------- promotions & emballages (phase 20)

enum PromotionType {
  FREE_UNITS
  PERCENT_DISCOUNT
}

enum PromotionClientScope {
  ALL
  PRICE_LEVEL
  SECTOR
  CLIENTS
}

enum PromotionTarget {
  PRODUCTS
  BRAND
  CATEGORY
}

/// Master data (PROMOTIONS): archived with deletedAt. A sale keeps the promotion's name and
/// values on its lines, so editing a promotion never changes a past document.
/// Product, unit, brand, category, level and sector ids are checked by the service (master
/// data is never deleted).
model Promotion {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  name          String               @db.VarChar(80)
  type          PromotionType
  /// Algiers days, both included.
  validFrom     DateTime             @db.Date
  validTo       DateTime             @db.Date
  active        Boolean              @default(true)
  /// Highest wins when several promotions match a line.
  priority      Int                  @default(0)
  clientScope   PromotionClientScope @default(ALL)
  priceLevelId  String?              @db.Uuid
  sectorId      String?              @db.Uuid
  /// FREE_UNITS: buy `buyQty` `buyUnitId` of `buyProductId`, get `freeQty` `freeUnitId` of `freeProductId`.
  buyProductId  String?              @db.Uuid
  buyUnitId     String?              @db.Uuid
  buyQty        Decimal?             @db.Decimal(14, 3)
  freeProductId String?              @db.Uuid
  freeUnitId    String?              @db.Uuid
  freeQty       Decimal?             @db.Decimal(14, 3)
  /// 10+1 repeatable: 25 bought gives 2 free.
  repeatable    Boolean              @default(true)
  /// PERCENT_DISCOUNT on products (PromotionProduct), a brand or a category (with its sub-categories).
  target        PromotionTarget?
  brandId       String?              @db.Uuid
  categoryId    String?              @db.Uuid
  discountPct   Decimal?             @db.Decimal(5, 2)
  /// Minimum quantity of the line, in the product's base unit.
  minQtyBase    Decimal?             @db.Decimal(14, 3)
  version       Int                  @default(1)
  createdBy     String?              @db.Uuid
  deletedAt     DateTime?            @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  products PromotionProduct[]
  clients  PromotionClient[]

  @@index([tenantId, validFrom, validTo])
  @@map("promotions")
}

model PromotionProduct {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  promotionId String @db.Uuid
  productId   String @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  promotion Promotion @relation(fields: [promotionId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([promotionId, productId])
  @@index([tenantId, productId])
  @@map("promotion_products")
}

model PromotionClient {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  promotionId String @db.Uuid
  clientId    String @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  promotion Promotion @relation(fields: [promotionId], references: [id])
  client    Client    @relation(fields: [clientId], references: [id])

  @@unique([promotionId, clientId])
  @@index([tenantId, clientId])
  @@map("promotion_clients")
}

enum PackagingEntryType {
  DELIVERY
  RETURN
  OPENING
  ADJUST
  REVERSAL
}

/// Emballage consigné (casier, palette, bouteille, bonbonne). Master data (PACKAGING).
model PackagingType {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  name         String    @db.VarChar(80)
  /// Deposit value shown to the client; no money is posted in phase 20.
  depositValue Decimal?  @db.Decimal(14, 2)
  deletedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  tenant   Tenant                   @relation(fields: [tenantId], references: [id])
  products ProductPackaging[]
  entries  ClientPackagingEntry[]
  balances ClientPackagingBalance[]

  @@index([tenantId, name])
  @@map("packaging_types")
}

/// A product travels in a packaging: one casier per 24 bouteilles (`qtyBasePerPackaging` = 24).
model ProductPackaging {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  productId           String   @db.Uuid
  packagingTypeId     String   @db.Uuid
  qtyBasePerPackaging Decimal  @db.Decimal(14, 3)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  packagingType PackagingType @relation(fields: [packagingTypeId], references: [id])

  @@unique([productId, packagingTypeId])
  @@index([tenantId, productId])
  @@map("product_packagings")
}

/// Packaging count ledger per client. Append-only (tenant extension + DB trigger).
/// Positive = given to the client, negative = returned. Written only through PackagingLedgerService.
model ClientPackagingEntry {
  id              String             @id @default(uuid()) @db.Uuid
  seq             BigInt             @unique @default(autoincrement())
  tenantId        String             @db.Uuid
  clientId        String             @db.Uuid
  packagingTypeId String             @db.Uuid
  type            PackagingEntryType
  qty             Int
  label           String             @db.VarChar(160)
  note            String?            @db.VarChar(255)
  refType         String?            @db.VarChar(30)
  refId           String?            @db.Uuid
  createdBy       String?            @db.Uuid
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  client        Client        @relation(fields: [clientId], references: [id])
  packagingType PackagingType @relation(fields: [packagingTypeId], references: [id])

  @@index([tenantId, clientId, seq])
  @@index([tenantId, refType, refId])
  @@map("client_packaging_entries")
}

/// Cached count per client and packaging, updated in the same transaction as the entries
/// and reconcilable from them.
model ClientPackagingBalance {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  clientId        String   @db.Uuid
  packagingTypeId String   @db.Uuid
  balance         Int      @default(0)
  hasOpening      Boolean  @default(false)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  client        Client        @relation(fields: [clientId], references: [id])
  packagingType PackagingType @relation(fields: [packagingTypeId], references: [id])

  @@unique([clientId, packagingTypeId])
  @@index([tenantId, clientId])
  @@map("client_packaging_balances")
}

// ---------------------------------------------------------------- Dépenses & loyers (phase 25)

enum ExpenseStatus {
  VALID
  CANCELLED
}

enum RentPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// A tenant's list of charge categories (master data, soft delete). Seeded ones keep a
/// `key` (RENT = Loyer) whatever the owner renames them to.
model ExpenseCategory {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String    @db.VarChar(60)
  key       String?   @db.VarChar(20)
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  expenses Expense[]

  @@unique([tenantId, key])
  @@index([tenantId, name])
  @@map("expense_categories")
}

/// Bail: the rent of a dépôt. Never edited after its first payment: a new rent closes it
/// (endDate) and opens a new one, so past months keep their cost. Its cost is computed by
/// day from these terms (packages/shared/rent.ts), never stored.
model RentContract {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @db.Uuid
  warehouseId   String     @db.Uuid
  landlordName  String     @db.VarChar(120)
  landlordPhone String?    @db.VarChar(30)
  amount        Decimal    @db.Decimal(14, 2)
  period        RentPeriod
  startDate     DateTime   @db.Date
  /// Last day included; null = open-ended.
  endDate       DateTime?  @db.Date
  note          String?    @db.VarChar(255)
  createdBy     String?    @db.Uuid
  closedBy      String?    @db.Uuid
  closedAt      DateTime?  @db.Timestamptz(3)
  version       Int        @default(1)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  payments  Expense[]

  @@index([tenantId, warehouseId])
  @@map("rent_contracts")
}

/// Dépense (DEP): money the company paid for a charge. Immutable once saved: a mistake is
/// cancelled (reason) and entered again. A Loyer payment links its contract and the
/// periods it pays; it is cash only, the contract carries the cost.
model Expense {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  number         String        @db.VarChar(20)
  /// The Algiers day the money left.
  date           DateTime      @db.Date
  warehouseId    String?       @db.Uuid
  categoryId     String        @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  mode           PaymentMode
  reference      String?       @db.VarChar(80)
  payee          String?       @db.VarChar(120)
  periodStart    DateTime?     @db.Date
  periodEnd      DateTime?     @db.Date
  note           String?       @db.VarChar(255)
  rentContractId String?       @db.Uuid
  /// An avance sur salaire (phase 31) or a salary payment (31b): cash, never a charge;
  /// hidden without SALARY_VIEW.
  employeeId     String?       @db.Uuid
  /// A salary payment: the approved run it pays (phase 31b).
  payrollRunId   String?       @db.Uuid
  /// The account it left (phase 34). Nullable until the contract release.
  cashAccountId  String?       @db.Uuid
  status         ExpenseStatus @default(VALID)
  createdBy      String?       @db.Uuid
  cancelReason   String?       @db.VarChar(255)
  cancelledBy    String?       @db.Uuid
  cancelledAt    DateTime?     @db.Timestamptz(3)
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  warehouse    Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  rentContract RentContract?   @relation(fields: [rentContractId], references: [id], onDelete: Restrict)
  employee     Employee?       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payrollRun   PayrollRun?     @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  cashAccount  CashAccount?    @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@unique([tenantId, number])
  @@index([tenantId, cashAccountId])
  @@index([tenantId, employeeId])
  @@index([tenantId, payrollRunId])
  @@index([tenantId, date])
  @@index([tenantId, warehouseId, date])
  @@index([tenantId, rentContractId])
  @@index([tenantId, periodEnd])
  @@map("expenses")
}

// ---------------------------------------------------------------- DRH (phase 31)

enum EmployeeContract {
  CDI
  CDD
  JOURNALIER
}

enum PayType {
  MONTHLY
  DAILY
}

enum AttendanceEventKind {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  CHECK_IN
  CHECK_OUT
  OVERTIME
  CORRECTION
}

enum AttendanceSource {
  MANAGER
  SELF
  IMPORT
}

enum AbsenceReason {
  JUSTIFIED
  SICK
  UNJUSTIFIED
}

enum DayStatus {
  PRESENT
  ABSENT_UNJUSTIFIED
  ABSENT_JUSTIFIED
  SICK
  LEAVE_PAID
  LEAVE_UNPAID
  HALF_DAY
  REST
  HOLIDAY
  NOT_EMPLOYED
  UNMARKED
}

enum LeaveType {
  PAID
  UNPAID
  SICK
  OTHER
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveEntryType {
  ACCRUAL
  TAKEN
  ADJUST
  OPENING
}

enum EmployeeLedgerType {
  ADVANCE
  REVERSAL
  OPENING
  SALARY_DUE
  SALARY_PAID
  ADVANCE_DEDUCTION
  SALARY_REVERSAL
}

/// A worker (master data, soft delete). Most have no app account: `userId` is optional.
model Employee {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  /// EMP-000001, per tenant.
  matricule       String           @db.VarChar(20)
  fullName        String           @db.VarChar(120)
  phone           String?          @db.VarChar(40)
  position        String?          @db.VarChar(80)
  warehouseId     String?          @db.Uuid
  userId          String?          @unique @db.Uuid
  hireDate        DateTime         @db.Date
  exitDate        DateTime?        @db.Date
  contract        EmployeeContract
  contractEndDate DateTime?        @db.Date
  /// Declared to the CNAS. Many small grossistes have undeclared workers: never refused.
  declared        Boolean          @default(false)
  nss             String?          @db.VarChar(30)
  nin             String?          @db.VarChar(30)
  birthDate       DateTime?        @db.Date
  /// RIB or CCP. Hidden without SALARY_VIEW.
  bankAccount     String?          @db.VarChar(40)
  /// Overrides the company's rest days; empty = the company's.
  restDays        Int[]            @default([]) @db.SmallInt
  createdBy       String?          @db.Uuid
  deletedAt       DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  warehouse     Warehouse?            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user          User?                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  salaries      EmployeeSalary[]
  balance       EmployeeBalance?
  ledger        EmployeeLedgerEntry[]
  events        AttendanceEvent[]
  days          AttendanceDay[]
  leaveRequests LeaveRequest[]
  leaveEntries  LeaveEntry[]
  expenses      Expense[]
  payItems      EmployeePayItem[]
  payslips      Payslip[]

  @@unique([tenantId, matricule])
  @@index([tenantId, warehouseId])
  @@index([tenantId, fullName])
  @@map("employees")
}

/// Append-only: the salary of a day is the last row on or before it.
model EmployeeSalary {
  id            String   @id @default(uuid()) @db.Uuid
  seq           BigInt   @unique @default(autoincrement())
  tenantId      String   @db.Uuid
  employeeId    String   @db.Uuid
  amount        Decimal  @db.Decimal(14, 2)
  payType       PayType
  effectiveFrom DateTime @db.Date
  reason        String?  @db.VarChar(255)
  createdBy     String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId, employeeId, effectiveFrom])
  @@map("employee_salaries")
}

/// Cached balances, written with their ledger row; reconciled nightly.
model EmployeeBalance {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  employeeId     String   @unique @db.Uuid
  /// What the worker owes the company in avances.
  advanceBalance Decimal  @default(0) @db.Decimal(14, 2)
  /// What the company still owes the worker in approved salaries (phase 31b).
  salaryDue      Decimal  @default(0) @db.Decimal(14, 2)
  leaveDays      Decimal  @default(0) @db.Decimal(6, 1)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@map("employee_balances")
}

/// The employee's account, like the supplier ledger. Append-only.
model EmployeeLedgerEntry {
  id           String             @id @default(uuid()) @db.Uuid
  seq          BigInt             @unique @default(autoincrement())
  tenantId     String             @db.Uuid
  employeeId   String             @db.Uuid
  type         EmployeeLedgerType
  /// Signed: + the worker owes more, − he owes less.
  amount       Decimal            @db.Decimal(14, 2)
  /// The balance the type moves: avances, or salary owed (`employeeBalanceDelta`).
  balanceAfter Decimal            @db.Decimal(14, 2)
  expenseId    String?            @db.Uuid
  payrollRunId String?            @db.Uuid
  note         String?            @db.VarChar(255)
  createdBy    String?            @db.Uuid
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId, employeeId, seq])
  @@index([tenantId, expenseId])
  @@index([tenantId, payrollRunId])
  @@map("employee_ledger_entries")
}

/// What happened on a day. Append-only: a mistake is fixed by a CORRECTION event.
model AttendanceEvent {
  id            String              @id @default(uuid()) @db.Uuid
  /// Insertion order (createdAt is shared by a transaction).
  seq           BigInt              @unique @default(autoincrement())
  tenantId      String              @db.Uuid
  employeeId    String              @db.Uuid
  /// The employee's dépôt at the time: a move never dodges a dépôt's month lock.
  warehouseId   String?             @db.Uuid
  /// The Algiers day.
  day           DateTime            @db.Date
  kind          AttendanceEventKind
  at            DateTime            @default(now()) @db.Timestamptz(3)
  source        AttendanceSource
  absenceReason AbsenceReason?
  correctedTo   DayStatus?
  lateMinutes   Int?                @db.SmallInt
  overtimeHours Decimal?            @db.Decimal(4, 2)
  note          String?             @db.VarChar(255)
  createdBy     String?             @db.Uuid
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId, employeeId, day, seq])
  @@index([tenantId, day])
  @@map("attendance_events")
}

/// Cached status of a day that has an event or an approved leave, written with it and
/// reconcilable. REST, HOLIDAY, UNMARKED and NOT_EMPLOYED days have no row: they are
/// derived on read by the same function.
model AttendanceDay {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  employeeId    String    @db.Uuid
  warehouseId   String?   @db.Uuid
  day           DateTime  @db.Date
  status        DayStatus
  lateMinutes   Int       @default(0) @db.SmallInt
  overtimeHours Decimal   @default(0) @db.Decimal(5, 2)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, employeeId, day])
  @@index([tenantId, day, status])
  @@map("attendance_days")
}

/// A month whose payroll is approved (phase 31b writes it): no new event, for one dépôt,
/// one employee, or (both null) the whole company. Enforced by trigger. The employee rows
/// cover a worker whose days sit in another dépôt, or in none.
model AttendanceMonthLock {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  /// YYYY-MM
  month        String   @db.VarChar(7)
  warehouseId  String?  @db.Uuid
  employeeId   String?  @db.Uuid
  /// The run that wrote it: cancelling the run removes it.
  payrollRunId String?  @db.Uuid
  createdBy    String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, month])
  @@index([tenantId, payrollRunId])
  @@map("attendance_month_locks")
}

// ---------------------------------------------------------------- Paie (phase 31b)

enum PayrollRunStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum PayItemMode {
  FIXED
  PER_DAY
}

enum PayrollManualKind {
  ITEM
  REGULARISATION
  RETENUE
}

/// CNAS and IRG rates, country-wide and owned by the super-admin. Append-only: a run uses
/// the set valid on the month's last day (latest effectiveFrom, then latest seq), so a
/// correction is a new row and an approved run never moves.
model PayrollRateSet {
  id                 String   @id @default(uuid()) @db.Uuid
  seq                BigInt   @unique @default(autoincrement())
  /// Null: a platform set, indicative, published by the super-admin. Else the company's own.
  tenantId           String?  @db.Uuid
  effectiveFrom      DateTime @db.Date
  cnasEmployeeRate   Decimal  @db.Decimal(6, 4)
  cnasEmployerRate   Decimal  @db.Decimal(6, 4)
  /// IrgBracket[] (packages/shared/payroll.ts): annual, lowest first.
  irgBrackets        Json
  abattementRate     Decimal  @db.Decimal(6, 4)
  abattementMin      Decimal  @db.Decimal(14, 2)
  abattementMax      Decimal  @db.Decimal(14, 2)
  exemptionThreshold Decimal  @db.Decimal(14, 2)
  lissageCeiling     Decimal  @db.Decimal(14, 2)
  lissageNum         Decimal  @db.Decimal(14, 4)
  lissageDen         Decimal  @db.Decimal(14, 4)
  lissageOffsetNum   Decimal  @db.Decimal(14, 4)
  lissageOffsetDen   Decimal  @db.Decimal(14, 4)
  snmg               Decimal  @db.Decimal(14, 2)
  /// Not checked by a comptable yet: the payslip screen says so.
  toVerify           Boolean  @default(true)
  note               String?  @db.VarChar(255)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  tenant        Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  runs          PayrollRun[]
  confirmations PayrollRateConfirmation[]

  @@index([tenantId, effectiveFrom, seq])
  @@map("payroll_rate_sets")
}

/// The owner's word on a rate set, append-only: who, when, which set, the text he read.
/// CONFIRMED lets runs on that set be approved; KEPT_OWN only answers the new-rates banner.
model PayrollRateConfirmation {
  id        String   @id @default(uuid()) @db.Uuid
  seq       BigInt   @unique @default(autoincrement())
  tenantId  String   @db.Uuid
  rateSetId String   @db.Uuid
  decision  String   @db.VarChar(16)
  text      String   @db.VarChar(255)
  locale    String   @db.VarChar(2)
  createdBy String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  rateSet PayrollRateSet @relation(fields: [rateSetId], references: [id])

  @@unique([tenantId, rateSetId, decision])
  @@map("payroll_rate_confirmations")
}

/// A prime or indemnité of the tenant (master data, soft delete).
model PayItemType {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  /// RENDEMENT, PANIER, TRANSPORT, EXCEPTIONNELLE on the seeded ones.
  key       String?     @db.VarChar(30)
  name      String      @db.VarChar(80)
  cotisable Boolean
  imposable Boolean
  mode      PayItemMode @default(FIXED)
  deletedAt DateTime?   @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  items       EmployeePayItem[]
  manualLines PayrollManualLine[]

  @@unique([tenantId, key])
  @@index([tenantId, deletedAt])
  @@map("pay_item_types")
}

/// A recurring prime of an employee. Append-only, like the salary: the last row of a type
/// on or before the day applies, and a row at 0 ends it.
model EmployeePayItem {
  id            String   @id @default(uuid()) @db.Uuid
  seq           BigInt   @unique @default(autoincrement())
  tenantId      String   @db.Uuid
  employeeId    String   @db.Uuid
  typeId        String   @db.Uuid
  amount        Decimal  @db.Decimal(14, 2)
  effectiveFrom DateTime @db.Date
  createdBy     String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])
  type     PayItemType @relation(fields: [typeId], references: [id])

  @@index([tenantId, employeeId, effectiveFrom])
  @@map("employee_pay_items")
}

/// The payroll of a month, for one dépôt or (warehouseId null) the company. A DRAFT is
/// recomputed at will; APPROVED is frozen (DB trigger) and only moves to CANCELLED, while
/// nothing was paid. At most one live run per month and dépôt (partial unique index).
model PayrollRun {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  /// PAIE-YYYY-000001, given at approval.
  number       String?          @db.VarChar(20)
  /// YYYY-MM
  month        String           @db.VarChar(7)
  warehouseId  String?          @db.Uuid
  status       PayrollRunStatus @default(DRAFT)
  rateSetId    String           @db.Uuid
  /// Goes up on each recompute; the owner approves the version he read.
  version      Int              @default(1)
  /// Hash of the computed payslips: tells whether the figures moved.
  fingerprint  String           @db.VarChar(64)
  computedAt   DateTime         @db.Timestamptz(3)
  computedBy   String?          @db.Uuid
  approvedAt   DateTime?        @db.Timestamptz(3)
  approvedBy   String?          @db.Uuid
  cancelledAt  DateTime?        @db.Timestamptz(3)
  cancelledBy  String?          @db.Uuid
  cancelReason String?          @db.VarChar(255)
  createdBy    String?          @db.Uuid
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  warehouse   Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  rateSet     PayrollRateSet      @relation(fields: [rateSetId], references: [id])
  payslips    Payslip[]
  manualLines PayrollManualLine[]
  expenses    Expense[]

  @@unique([tenantId, number])
  @@index([tenantId, month])
  @@index([tenantId, status, month])
  @@map("payroll_runs")
}

/// One employee on one run, with everything printed frozen. No row is ever updated once
/// the run left DRAFT (DB trigger).
model Payslip {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  runId           String   @db.Uuid
  employeeId      String   @db.Uuid
  /// YYYY-MM, as on the run.
  month           String   @db.VarChar(7)
  /// The employee's dépôt for this month: the charges count here.
  warehouseId     String?  @db.Uuid
  rateSetId       String   @db.Uuid
  rateSetToVerify Boolean
  fullName        String   @db.VarChar(120)
  matricule       String   @db.VarChar(20)
  position        String?  @db.VarChar(80)
  nss             String?  @db.VarChar(30)
  declared        Boolean
  payType         PayType?
  salary          Decimal  @db.Decimal(14, 2)
  /// PayDaySummary (packages/shared/payroll.ts).
  days            Json
  /// PayslipIssue[]: what blocks or warns, for the run screen.
  issues          Json
  /// IrgDetail.
  irgDetail       Json
  gross           Decimal  @db.Decimal(14, 2)
  cotisable       Decimal  @db.Decimal(14, 2)
  cnasEmployee    Decimal  @db.Decimal(14, 2)
  cnasEmployer    Decimal  @db.Decimal(14, 2)
  taxable         Decimal  @db.Decimal(14, 2)
  irg             Decimal  @db.Decimal(14, 2)
  net             Decimal  @db.Decimal(14, 2)
  retenues        Decimal  @db.Decimal(14, 2)
  advanceDeducted Decimal  @db.Decimal(14, 2)
  advanceCarried  Decimal  @db.Decimal(14, 2)
  netToPay        Decimal  @db.Decimal(14, 2)
  employerCost    Decimal  @db.Decimal(14, 2)
  /// Year to date, this month included.
  cumulGross      Decimal  @db.Decimal(14, 2)
  cumulIrg        Decimal  @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  run      PayrollRun    @relation(fields: [runId], references: [id])
  employee Employee      @relation(fields: [employeeId], references: [id])
  lines    PayslipLine[]

  @@unique([runId, employeeId])
  @@index([tenantId, employeeId, month])
  @@index([tenantId, month])
  @@map("payslips")
}

model PayslipLine {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  runId          String   @db.Uuid
  payslipId      String   @db.Uuid
  position       Int      @db.SmallInt
  /// PayLineCode.
  code           String   @db.VarChar(30)
  label          String   @db.VarChar(120)
  quantity       Decimal? @db.Decimal(10, 2)
  base           Decimal? @db.Decimal(14, 2)
  rate           Decimal? @db.Decimal(8, 4)
  amount         Decimal  @db.Decimal(14, 2)
  cotisable      Boolean
  imposable      Boolean
  /// The approved incentive run a prime comes from: it is paid once.
  incentiveRunId String?  @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([tenantId, payslipId])
  @@index([tenantId, incentiveRunId])
  @@map("payslip_lines")
}

/// What was entered by hand on a draft: it survives a recompute, and freezes with the run.
model PayrollManualLine {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @db.Uuid
  runId      String            @db.Uuid
  employeeId String            @db.Uuid
  kind       PayrollManualKind
  typeId     String?           @db.Uuid
  label      String            @db.VarChar(120)
  /// Signed for a régularisation.
  amount     Decimal           @db.Decimal(14, 2)
  cotisable  Boolean           @default(false)
  imposable  Boolean           @default(false)
  note       String?           @db.VarChar(255)
  createdBy  String?           @db.Uuid
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  run    PayrollRun   @relation(fields: [runId], references: [id])
  type   PayItemType? @relation(fields: [typeId], references: [id])

  @@index([tenantId, runId, employeeId])
  @@map("payroll_manual_lines")
}

/// Fêtes légales. Fixed ones are seeded every year with a key; lunar ones are entered by
/// the tenant because their dates move. Calendar settings, so a wrong row can be removed.
model PublicHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  date      DateTime @db.Date
  name      String   @db.VarChar(80)
  key       String?  @db.VarChar(30)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date])
  @@map("public_holidays")
}

model LeaveRequest {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  employeeId     String             @db.Uuid
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  type           LeaveType
  status         LeaveRequestStatus @default(PENDING)
  /// Working days covered, at request time; recomputed on approval.
  days           Decimal            @db.Decimal(6, 1)
  note           String?            @db.VarChar(255)
  decisionReason String?            @db.VarChar(255)
  decidedBy      String?            @db.Uuid
  decidedAt      DateTime?          @db.Timestamptz(3)
  createdBy      String?            @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  employee Employee     @relation(fields: [employeeId], references: [id])
  entries  LeaveEntry[]

  @@index([tenantId, status, startDate])
  @@index([tenantId, employeeId, startDate])
  @@map("leave_requests")
}

/// The congé ledger, in days. Append-only; balance = sum.
model LeaveEntry {
  id             String         @id @default(uuid()) @db.Uuid
  seq            BigInt         @unique @default(autoincrement())
  tenantId       String         @db.Uuid
  employeeId     String         @db.Uuid
  type           LeaveEntryType
  /// Signed days.
  days           Decimal        @db.Decimal(6, 1)
  /// YYYY-MM of an accrual: one per employee and month (partial unique index).
  month          String?        @db.VarChar(7)
  leaveRequestId String?        @db.Uuid
  note           String?        @db.VarChar(255)
  createdBy      String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  employee     Employee      @relation(fields: [employeeId], references: [id])
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId, seq])
  @@map("leave_entries")
}

// --- Assistant IA (phase 30) ------------------------------------------------------------

enum AiProvider {
  ANTHROPIC
  GEMINI
  OPENAI_COMPATIBLE
}

enum AiConfigScope {
  PLATFORM
  TENANT
}

enum AssistantRole {
  USER
  ASSISTANT
}

/// Which model answers. One PLATFORM row (tenantId null, super-admin), at most one TENANT row
/// per company. Partial unique indexes and a CHECK in the migration. A company never reads
/// the PLATFORM row: only AiConfigService does, in the system context.
model AiProviderConfig {
  id                         String        @id @default(uuid()) @db.Uuid
  scope                      AiConfigScope
  tenantId                   String?       @db.Uuid
  provider                   AiProvider
  model                      String        @db.VarChar(120)
  baseUrl                    String?       @db.VarChar(255)
  /// secret-box output. Never returned, never logged.
  apiKeyEncrypted            String
  /// Last 4 characters of the key, for the form.
  keyHint                    String        @db.VarChar(8)
  inputPricePerMTokUsd       Decimal       @db.Decimal(12, 4)
  cachedInputPricePerMTokUsd Decimal       @db.Decimal(12, 4)
  outputPricePerMTokUsd      Decimal       @db.Decimal(12, 4)
  enabled                    Boolean       @default(true)
  /// A user id, or a platform admin id on a PLATFORM row.
  updatedBy                  String        @db.Uuid
  createdAt                  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime      @updatedAt @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("ai_provider_configs")
}

/// Chat history, not business data: the user can really delete it, and it goes after 90 days.
model AssistantConversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  title     String   @db.VarChar(120)
  language  String?  @db.VarChar(8)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user     User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages AssistantMessage[]

  @@index([tenantId, userId, createdAt(sort: Desc), id])
  @@index([createdAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id              String         @id @default(uuid()) @db.Uuid
  seq             BigInt         @unique @default(autoincrement())
  tenantId        String         @db.Uuid
  conversationId  String         @db.Uuid
  userId          String         @db.Uuid
  role            AssistantRole
  content         String
  /// [{ name, input, status }]: what was asked, never what came back.
  toolCalls       Json?
  /// Screen links offered with an answer.
  links           Json?
  inputTokens     Int            @default(0)
  cachedTokens    Int            @default(0)
  outputTokens    Int            @default(0)
  provider        AiProvider?
  model           String?        @db.VarChar(120)
  /// On USER rows too: only PLATFORM questions count against the plan.
  configScope     AiConfigScope?
  /// From the config's prices at the time.
  costMicroUsd    BigInt         @default(0)
  useful          Boolean?
  feedbackComment String?        @db.VarChar(500)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, role, configScope, createdAt])
  @@index([tenantId, userId, role, createdAt])
  @@index([conversationId, seq])
  @@map("assistant_messages")
}

// ---------------------------------------------------------------- trésorerie (phase 34)

enum CashAccountType {
  CAISSE
  BANQUE
  CCP
}

enum CashMovementType {
  OPENING
  VERSEMENT
  SUPPLIER_PAYMENT
  EXPENSE
  IMPORT_COST
  TRANSFER_OUT
  TRANSFER_IN
  COUNT_ADJUST
  REVERSAL
}

enum CashTransferStatus {
  VALID
  CANCELLED
}

/// A caisse or a bank account. Master data: archived, never deleted. One default per type and
/// dépôt, and one live name per tenant: partial unique indexes in the migration.
model CashAccount {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  name        String          @db.VarChar(80)
  type        CashAccountType
  /// Null: a company account, reached by managers only.
  warehouseId String?         @db.Uuid
  bankName    String?         @db.VarChar(80)
  rib         String?         @db.VarChar(30)
  isDefault   Boolean         @default(false)
  /// DZD only for now: foreign accounts are parked.
  currency    String          @default("DZD") @db.VarChar(3)
  /// The day of the solde initial: movements dated before it are not in the balance.
  openingDate DateTime?       @db.Date
  version     Int             @default(1)
  createdBy   String?         @db.Uuid
  deletedAt   DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  warehouse        Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  balance          CashAccountBalance?
  movements        CashMovement[]
  counts           CashCount[]
  transfersOut     CashTransfer[]      @relation("CashTransferFrom")
  transfersIn      CashTransfer[]      @relation("CashTransferTo")
  payments         Payment[]
  supplierPayments SupplierPayment[]
  expenses         Expense[]
  importCosts      ImportCost[]
  purchases        Purchase[]

  @@index([tenantId, type])
  @@index([tenantId, warehouseId])
  @@map("cash_accounts")
}

/// Cached balance of an account: updated in the same transaction as its movement and
/// reconcilable from the ledger. Locked by id order when a transfer takes two.
model CashAccountBalance {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  cashAccountId String   @unique @db.Uuid
  balance       Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  account CashAccount @relation(fields: [cashAccountId], references: [id])

  @@index([tenantId])
  @@map("cash_account_balances")
}

/// The cash ledger: append-only (DB trigger). Signed: + in, - out.
model CashMovement {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  cashAccountId String           @db.Uuid
  amount        Decimal          @db.Decimal(14, 2)
  type          CashMovementType
  refType       String?          @db.VarChar(40)
  refId         String?          @db.Uuid
  /// The Algiers day the money moved.
  date          DateTime         @db.Date
  note          String?          @db.VarChar(255)
  createdBy     String?          @db.Uuid
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  account CashAccount @relation(fields: [cashAccountId], references: [id])

  @@index([tenantId, cashAccountId, date, createdAt])
  @@index([tenantId, date])
  @@index([tenantId, refType, refId])
  @@map("cash_movements")
}

/// Transfert (TRF): from one account to another. Neither income nor a charge.
model CashTransfer {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  number        String             @db.VarChar(20)
  fromAccountId String             @db.Uuid
  toAccountId   String             @db.Uuid
  amount        Decimal            @db.Decimal(14, 2)
  date          DateTime           @db.Date
  note          String?            @db.VarChar(255)
  status        CashTransferStatus @default(VALID)
  createdBy     String?            @db.Uuid
  cancelReason  String?            @db.VarChar(255)
  cancelledBy   String?            @db.Uuid
  cancelledAt   DateTime?          @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  from   CashAccount @relation("CashTransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  to     CashAccount @relation("CashTransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@unique([tenantId, number])
  @@index([tenantId, date])
  @@map("cash_transfers")
}

/// Comptage de caisse: what was counted against the balance at that moment. The écart, when
/// there is one, is a COUNT_ADJUST movement.
model CashCount {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  cashAccountId String   @db.Uuid
  counted       Decimal  @db.Decimal(14, 2)
  expected      Decimal  @db.Decimal(14, 2)
  ecart         Decimal  @db.Decimal(14, 2)
  reason        String?  @db.VarChar(255)
  /// The écart reached the tenant's threshold: shown to the owner.
  alert         Boolean  @default(false)
  createdBy     String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  account CashAccount @relation(fields: [cashAccountId], references: [id])

  @@index([tenantId, cashAccountId, createdAt])
  @@index([tenantId, alert, createdAt])
  @@map("cash_counts")
}
