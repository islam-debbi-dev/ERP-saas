// Phase 1 schema: tenancy, users, sessions, audit, numbering, idempotency.
// Rules (AGENTS.md §3): every business table has tenantId (indexes start with it),
// money is Decimal(14,2), no hard deletes on business data, audit log is append-only.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  SELLER
  STOREKEEPER
}

enum CreditLimitMode {
  WARN
  BLOCK
}

enum NegativeStockMode {
  ALLOW
  WARN
  BLOCK
}

enum DocType {
  BL
  FAC
  AV
  BR
  VER
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

/// A grossiste (our customer). Holds the tenant settings from docs/domain.md.
model Tenant {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)

  // Invoice header
  raisonSociale String  @db.VarChar(160)
  adresse       String? @db.VarChar(255)
  telephone     String? @db.VarChar(40)
  rc            String? @db.VarChar(40)
  nif           String? @db.VarChar(40)
  nis           String? @db.VarChar(40)
  ai            String? @db.VarChar(40)
  rib           String? @db.VarChar(60)

  // Business rules
  assujettiTva      Boolean           @default(true)
  creditLimitMode   CreditLimitMode   @default(WARN)
  negativeStockMode NegativeStockMode @default(WARN)
  priceLevelCount   Int               @default(3) @db.SmallInt

  // Timbre fiscal rule (cash-paid factures). Off until the tenant sets current law values.
  timbreEnabled   Boolean  @default(false)
  timbreRate      Decimal? @db.Decimal(7, 4) // percent, e.g. 1.0000
  timbreMin       Decimal? @db.Decimal(14, 2)
  timbreMax       Decimal? @db.Decimal(14, 2)
  timbreThreshold Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users             User[]
  sessions          Session[]
  auditLogs         AuditLog[]
  documentSequences DocumentSequence[]
  idempotencyKeys   IdempotencyKey[]
  categories        Category[]
  units             Unit[]
  priceLevels       PriceLevel[]
  products          Product[]
  productUnits      ProductUnit[]
  productPrices     ProductPrice[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  /// Globally unique (lowercased) so login needs no company code.
  email        String    @unique @db.VarChar(254)
  passwordHash String    @db.VarChar(255)
  fullName     String    @db.VarChar(120)
  role         Role
  deletedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  sessions Session[]

  @@index([tenantId, role])
  @@map("users")
}

/// One logged-in device. The refresh token is `<sessionId>.<secret>`; only sha256(secret) is stored.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @db.Char(64)
  deviceName       String?   @db.VarChar(100)
  userAgent        String?   @db.VarChar(255)
  ip               String?   @db.VarChar(45)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  /// LOGOUT | REVOKED | REUSE_DETECTED
  revokedReason    String?   @db.VarChar(30)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, revokedAt])
  @@map("sessions")
}

/// Append-only: never updated or deleted (enforced by the tenant Prisma extension).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  sessionId  String?  @db.Uuid
  deviceName String?  @db.VarChar(100)
  ip         String?  @db.VarChar(45)
  action     String   @db.VarChar(60)
  entity     String   @db.VarChar(60)
  entityId   String?  @db.VarChar(64)
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}

/// Last number used per tenant, document type and year. Incremented under SELECT ... FOR UPDATE.
model DocumentSequence {
  tenantId   String  @db.Uuid
  docType    DocType
  year       Int     @db.SmallInt
  lastNumber Int     @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, docType, year])
  @@map("document_sequences")
}

model IdempotencyKey {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  key            String            @db.VarChar(100)
  method         String            @db.VarChar(10)
  path           String            @db.VarChar(255)
  /// sha256 of method + path + canonical JSON body.
  requestHash    String            @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @db.SmallInt
  responseBody   Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?         @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId, createdAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------- catalog (phase 2)

/// Product category. One level of nesting (enforced in CategoriesService).
/// Name uniqueness among live categories is checked in the service under a tenant lock.
model Category {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String    @db.VarChar(80)
  parentId  String?   @db.Uuid
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([tenantId, parentId])
  @@map("categories")
}

/// Tenant-level unit catalog. Default units have a stable code translated in the UI;
/// custom units have code CUSTOM-xxxx and a free-text name.
model Unit {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  code          String   @db.VarChar(40)
  name          String?  @db.VarChar(40)
  allowsDecimal Boolean
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  baseOf       Product[]
  productUnits ProductUnit[]

  @@unique([tenantId, code])
  @@map("units")
}

/// Price levels 1..5 (Gros, Demi-gros, Détail...). Only the first `priceLevelCount` are shown.
model PriceLevel {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  position  Int      @db.SmallInt
  name      String   @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  prices ProductPrice[]

  @@unique([tenantId, position])
  @@map("price_levels")
}

/// Master data: archived with deletedAt, never deleted.
model Product {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  reference   String    @db.VarChar(40)
  designation String    @db.VarChar(160)
  categoryId  String?   @db.Uuid
  baseUnitId  String    @db.Uuid
  tvaRate     Decimal   @db.Decimal(5, 2)
  minStock    Decimal   @default(0) @db.Decimal(14, 3)
  active      Boolean   @default(true)
  /// Optimistic lock: every update must send the version it read.
  version     Int       @default(1)
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  category Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  baseUnit Unit           @relation(fields: [baseUnitId], references: [id])
  units    ProductUnit[]
  prices   ProductPrice[]

  @@unique([tenantId, reference])
  @@index([tenantId, designation])
  @@index([tenantId, categoryId])
  @@map("products")
}

/// A unit a product is sold or bought in (pièce, carton = 24...). The base unit has factor 1.
/// Removing a unit soft-deletes it and moves its barcode to deletedBarcode, freeing the code.
model ProductUnit {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  productId         String    @db.Uuid
  unitId            String    @db.Uuid
  factorToBase      Decimal   @db.Decimal(14, 3)
  barcode           String?   @db.VarChar(64)
  deletedBarcode    String?   @db.VarChar(64)
  isDefaultSale     Boolean   @default(false)
  isDefaultPurchase Boolean   @default(false)
  deletedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  product Product        @relation(fields: [productId], references: [id])
  unit    Unit           @relation(fields: [unitId], references: [id])
  prices  ProductPrice[]

  /// One barcode per tenant across all units (NULLs are allowed many times).
  @@unique([tenantId, barcode])
  @@unique([productId, unitId])
  @@map("product_units")
}

/// Current selling price HT for one product unit at one price level.
/// History lives in the audit log (old and new value on every change).
model ProductPrice {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  productId     String   @db.Uuid
  productUnitId String   @db.Uuid
  priceLevelId  String   @db.Uuid
  priceHt       Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id])
  priceLevel  PriceLevel  @relation(fields: [priceLevelId], references: [id])

  @@unique([productUnitId, priceLevelId])
  @@index([tenantId, productId])
  @@map("product_prices")
}
