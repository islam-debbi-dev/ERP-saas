# Copy to apps/api/.env. Never commit the real .env.

# Postgres from infra/docker-compose.yml. The API connects as erp_app, which row-level
# security binds (created on the db's first start by infra/postgres/init).
DATABASE_URL=postgresql://erp_app:erp_app@localhost:5432/erp?schema=public
# The owner: migrations (pnpm db:migrate) and the seed.
DATABASE_URL_MIGRATE=postgresql://erp:erp@localhost:5432/erp?schema=public
# Integration tests: a separate DB that tests migrate themselves (db_test service). Give
# the owner; the suite creates erp_app (password erp_app) and runs the app as it.
# DATABASE_URL_TEST_APP overrides that app-role URL.
DATABASE_URL_TEST=postgresql://erp:erp@localhost:5433/erp_test?schema=public

PORT=3001
# Origin of the web app, for CORS and the refresh-token cookie.
WEB_ORIGIN=http://localhost:3000

# Long random string (min 32 chars). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-local-only-secret-32chars-min
# Access token lifetime in seconds (15 min).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token / session lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30
# Seconds the previous refresh token stays valid after a rotation (lost response on
# reload, second tab). Reuse after this window closes the session. 0 disables it.
REFRESH_REUSE_GRACE_SECONDS=60
# Set to true behind HTTPS so the refresh cookie gets the Secure flag.
COOKIE_SECURE=false

# trace | debug | info | warn | error
LOG_LEVEL=info
# local | staging | production: tags Sentry events.
APP_ENV=local
# Leave empty to disable Sentry.
SENTRY_DSN=
# Git sha of the build (set by the image build); shown by /health and tags Sentry.
SENTRY_RELEASE=

# Requests per minute per IP: every route, and the auth routes (register, refresh, invitations).
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=30
# Path the reverse proxy serves the API under (/api in production); empty in dev.
PUBLIC_PATH_PREFIX=

# Password of the demo owner created by `pnpm db:seed` (demo@grossiste.dz).
SEED_OWNER_PASSWORD=Demo1234!

# PDF printing: Chromium used by puppeteer. Empty = the browser `pnpm install` downloaded
# (~/.cache/puppeteer). The Docker image sets /usr/bin/chromium-browser.
CHROMIUM_PATH=
