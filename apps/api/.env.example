# Copy to apps/api/.env. Never commit the real .env.

# Postgres from infra/docker-compose.yml
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp?schema=public
# Integration tests: a separate DB that tests reset and migrate themselves (db_test service).
DATABASE_URL_TEST=postgresql://erp:erp@localhost:5433/erp_test?schema=public

PORT=3001
# Origin of the web app, for CORS and the refresh-token cookie.
WEB_ORIGIN=http://localhost:3000

# Long random string (min 32 chars). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-local-only-secret-32chars-min
# Access token lifetime in seconds (15 min).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token / session lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30
# Seconds the previous refresh token stays valid after a rotation (lost response on
# reload, second tab). Reuse after this window closes the session. 0 disables it.
REFRESH_REUSE_GRACE_SECONDS=60
# Set to true behind HTTPS so the refresh cookie gets the Secure flag.
COOKIE_SECURE=false

# trace | debug | info | warn | error
LOG_LEVEL=info
# Leave empty to disable Sentry.
SENTRY_DSN=

# Password of the demo owner created by `pnpm db:seed` (demo@grossiste.dz).
SEED_OWNER_PASSWORD=Demo1234!
