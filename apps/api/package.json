{
  "name": "@erp/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "reconcile": "node dist/reconcile/reconcile.cli.js",
    "db:backfill-supplier-ledger": "node dist/purchases/supplier-backfill.cli.js",
    "db:backfill-warehouses": "node dist/stock/warehouse-backfill.cli.js",
    "db:backfill-units": "node dist/stock/unit-backfill.cli.js",
    "treasury:backfill": "node dist/treasury/treasury-backfill.cli.js",
    "db:check-migrations": "tsx scripts/check-migrations.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "assistant:help": "tsx scripts/assistant-help.ts",
    "assistant:eval": "tsx scripts/assistant-eval.ts",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --selectProjects unit",
    "test:int": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --selectProjects integration",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@erp/shared": "workspace:*",
    "@google/genai": "^2.32.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nestjs": "^11.8.0",
    "@sparticuz/chromium": "153.0.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "openai": "^7.49.0",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "7.10.1",
    "puppeteer": "^25.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15"
  }
}
