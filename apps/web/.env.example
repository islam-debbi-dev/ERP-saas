# Copy to apps/web/.env.local. Never commit the real file.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Leave empty to disable Sentry in the browser. SENTRY_DSN (server side) is runtime.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=

# Support links in the sidebar (phase 13). Each link is hidden while its value is empty.
# WhatsApp number in international form, digits only (e.g. 213550123456).
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Short tutorial videos (YouTube or any URL).
NEXT_PUBLIC_TUTORIAL_FIRST_STEPS_URL=
NEXT_PUBLIC_TUTORIAL_IMPORT_URL=
NEXT_PUBLIC_TUTORIAL_SALE_URL=
NEXT_PUBLIC_TUTORIAL_VERSEMENT_URL=
