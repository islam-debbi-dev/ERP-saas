{
  "name": "erp-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:db": "tsx sql/run-invariants.ts",
    "test:api": "tsx api/scenario.ts && tsx api/attacks.ts",
    "test:web": "playwright test --config web/playwright.config.ts",
    "install:browsers": "playwright install chromium",
    "test:map:seed": "tsx api/map-seed.ts",
    "test:map:api": "tsx api/map-props.ts && tsx api/map.ts",
    "test:map:privacy": "tsx api/map-privacy.ts; T35_MATCH=position-privacy playwright test --config web/map.playwright.config.ts --project m393-fr",
    "test:map:perf": "tsx api/map-perf.ts; T35_MATCH=map-perf playwright test --config web/map.playwright.config.ts --project m360-fr"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.10",
    "pdfjs-dist": "^4.10.38",
    "tsx": "^4.19.2"
  }
}
